#!/usr/bin/bash
# DJOS: paru como en Arch/CachyOS, pero adentro de un contenedor Arch (distrobox), así el sistema no se toca.
# Uso: paru -S algo | paru -Syu | paru algo | paru -R algo   (los argumentos pasan tal cual a paru).
# Las apps con ícono que se instalan aparecen solas en el menú de KDE, y se van al desinstalarlas.
set -u

BOX=${DJOS_PARU_BOX:-arch}
IMAGE=${DJOS_PARU_IMAGE:-docker.io/library/archlinux:latest}

if [ "$(id -u)" = 0 ]; then
    echo "paru: don't run paru with sudo or as root. Run it as your normal user: paru $*" >&2
    exit 1
fi
command -v distrobox >/dev/null || { echo "paru: distrobox is not installed." >&2; exit 1; }

# ¿ya existe la caja?
have_box() {
    distrobox list --no-color 2>/dev/null | awk -F'|' 'NR > 1 { gsub(/ /, "", $2); print $2 }' | grep -qx "$BOX"
}

if ! have_box; then
    echo ":: paru: first run. Setting up an Arch Linux container ('$BOX') for AUR and Arch packages."
    echo ":: This downloads about 500 MB and takes a few minutes. It only happens once."
    distrobox create --yes --name "$BOX" --image "$IMAGE" || {
        echo "paru: could not create the '$BOX' container (check your internet connection)." >&2
        exit 1
    }
fi

# todo lo que corre adentro de la caja: bootstrap (si falta), paru, y sincronizar el menú
read -r -d '' INNER <<'EOF'
set -u
box=$1; shift
st=$HOME/.local/state/djos; apps_dir=$HOME/.local/share/applications; bin_dir=$HOME/.local/bin
mkdir -p "$st"
list_apps() { for f in /usr/share/applications/*.desktop; do [ -e "$f" ] && basename "$f" .desktop; done | sort -u; }
list_bins() { ls -1 /usr/bin | sort -u; }

paru_ok() { paru --version >/dev/null 2>&1; }
aur_build() {  # arma e instala un paquete del AUR; -r saca las dependencias de compilación
    local tmp rc
    tmp=$(mktemp -d) || return 1
    ( cd "$tmp" && git clone --depth 1 "https://aur.archlinux.org/$1.git" && cd "$1" && makepkg -si -r --noconfirm )
    rc=$?; rm -rf "$tmp"; return "$rc"
}

# falta paru, o quedó roto porque Arch subió la versión de libalpm (pasa cada tanto)
if ! paru_ok; then
    first=0; command -v paru >/dev/null || first=1
    if [ "$first" = 1 ]; then
        echo ":: paru: installing build tools (base-devel, git) in '$box'..."
    else
        echo ":: paru: paru no longer matches Arch's pacman, rebuilding it..."
    fi
    sudo pacman -Syu --noconfirm --needed base-devel git || exit 1
    if [ "$first" = 1 ]; then
        echo ":: paru: installing paru (paru-bin) from the AUR..."
        aur_build paru-bin
    fi
    if ! paru_ok; then
        echo ":: paru: compiling paru from source (the prebuilt one doesn't fit this pacman). This takes a few minutes..."
        for p in paru-bin paru-bin-debug; do
            pacman -Qq "$p" >/dev/null 2>&1 && sudo pacman -Rdd --noconfirm "$p" >/dev/null
        done
        aur_build paru
    fi
    paru_ok || { echo "paru: could not install paru inside '$box'. Check your connection and try again." >&2; exit 1; }
    if [ "$first" = 1 ]; then
        # lo que ya venía en la caja no se exporta
        list_apps > "$st/paru-$box.apps"; list_bins > "$st/paru-$box.bins"
        echo ":: paru: ready. Apps you install will show up in the app menu."
    fi
fi
[ -f "$st/paru-$box.apps" ] || list_apps > "$st/paru-$box.apps"
[ -f "$st/paru-$box.bins" ] || list_bins > "$st/paru-$box.bins"

paru "$@"; rc=$?

# menú: exportar las apps nuevas
list_apps > "$st/apps.now"
for a in $(comm -13 "$st/paru-$box.apps" "$st/apps.now"); do
    f=$apps_dir/$box-$a.desktop
    [ -e "$f" ] && continue
    if distrobox-export --app "/usr/share/applications/$a.desktop" >/dev/null 2>&1; then
        # pasamos la ruta completa para no agarrar otras apps; arreglamos la clase de ventana
        sed -i "s|^StartupWMClass=/usr/share/applications/$a.desktop\$|StartupWMClass=$a|" "$f" 2>/dev/null
        echo ":: Added to the app menu: $a"
    fi
done
# y sacar las que ya no están (distrobox-export --delete no las encuentra si el paquete ya se fue)
removed=0
for f in "$apps_dir/$box-"*.desktop; do
    [ -e "$f" ] || continue
    grep -q "distrobox.*enter.* -n $box " "$f" || continue
    a=$(basename "$f" .desktop); a=${a#"$box-"}
    [ -e "/usr/share/applications/$a.desktop" ] && continue
    rm -f "$f" && removed=1 && echo ":: Removed from the app menu: $a"
done
[ "$removed" = 1 ] && { distrobox-host-exec --yes update-desktop-database "$apps_dir" >/dev/null 2>&1 || :; }
mv -f "$st/apps.now" "$st/paru-$box.apps"

# comandos: exportar a ~/.local/bin los de paquetes pedidos a mano, si no pisan uno del sistema
list_bins > "$st/bins.now"
new=$(comm -13 "$st/paru-$box.bins" "$st/bins.now")
if [ -n "$new" ]; then
    explicit=$(pacman -Qqe)
    for b in $new; do
        [ -e "/run/host/usr/bin/$b" ] || [ -e "/run/host/usr/sbin/$b" ] || [ -e "/run/host/usr/local/bin/$b" ] && continue
        [ -e "$bin_dir/$b" ] && continue
        p=$(pacman -Qqo "/usr/bin/$b" 2>/dev/null) || continue
        printf '%s\n' "$explicit" | grep -qxF "$p" || continue
        distrobox-export --bin "/usr/bin/$b" --export-path "$bin_dir" >/dev/null 2>&1 && echo ":: Command available: $b"
    done
fi
for f in "$bin_dir"/*; do
    [ -f "$f" ] || continue
    grep -q '^# distrobox_binary' "$f" && grep -qx "# name: $box" "$f" || continue
    t=$(grep -o "'/usr/[^']*'" "$f" | head -n 1 | tr -d "'")
    [ -n "$t" ] && [ ! -e "$t" ] && rm -f "$f" && echo ":: Command removed: $(basename "$f")"
done
mv -f "$st/bins.now" "$st/paru-$box.bins"
exit "$rc"
EOF

exec distrobox enter "$BOX" -- bash -c "$INNER" djos-paru "$BOX" "$@"
