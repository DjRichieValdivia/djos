# DJOS: al terminar una instalación offline (Install & restart / shut down de DJOS, o Discover), antes de reiniciar o
# apagar, compila el driver de NVIDIA para el núcleo con el que va a arrancar la PC. Instalando offline akmods no
# compila: lo dejaba para el próximo arranque (1-3 minutos en la pantalla de inicio, justo antes de un set) y, si solo
# cambió el driver, la PC arrancaba con el módulo viejo (no coincide con el resto del driver hasta reiniciar otra vez).
# Arranca con la actualización (no hace nada) y trabaja al detenerse (ExecStop): dnf5 reinicia o apaga con logind, que
# detiene los servicios, y este se detiene antes de desmontar los discos. Sin akmods (sin NVIDIA) no corre.
[Unit]
Description=DJOS: build the NVIDIA driver for the new kernel before restarting
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target local-fs.target
Before=dnf5-offline-transaction.service packagekit-offline-update.service
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=/usr/sbin/akmods

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=-/usr/libexec/djos/nvidia-setup --offline-build
TimeoutStopSec=30min

[Install]
WantedBy=system-update.target
