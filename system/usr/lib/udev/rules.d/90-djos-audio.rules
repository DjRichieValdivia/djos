# DJOS
# PM QoS: el grupo audio puede pedir que el procesador no entre en reposo profundo mientras suena (Richie DJ
# escribe 20 µs en /dev/cpu_dma_latency al abrir la salida de audio y lo suelta al cerrarla).
KERNEL=="cpu_dma_latency", GROUP="audio", MODE="0660"

# Placas de audio USB (consolas DJ, interfaces): sin ahorro de energía del USB, que puede cortar el audio.
ACTION=="add", SUBSYSTEM=="usb", ATTR{bInterfaceClass}=="01", TEST=="../power/control", ATTR{../power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", DRIVERS=="snd-usb-audio", TEST=="power/control", ATTR{power/control}="on"
