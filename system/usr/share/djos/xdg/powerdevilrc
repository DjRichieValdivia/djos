# DJOS: enchufada, la PC nunca se suspende ni apaga o atenúa la pantalla sola (la consola DJ no cuenta como
# "actividad" para el escritorio: sin esto, la PC se dormiría en medio de un set)
[AC][SuspendAndShutdown]
AutoSuspendAction=0

[AC][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=false
