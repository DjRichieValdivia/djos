#!/usr/bin/bash
# DJOS: estado de las actualizaciones en JSON, para el panel "DJOS Updates" (lo corre el usuario, sin permisos).
#   system   versión en uso y, si ya se bajó una nueva, la que se aplica al reiniciar
#   apps     programas privados (Richie DJ): lo que anota djos-app-update en /var/lib/djos/apps/
#   flatpak  cuántos programas de Flathub tienen actualización
set -u
st=$(rpm-ostree status --json 2>/dev/null || echo '{}')
booted=$(jq -r '[.deployments[]? | select(.booted)][0].version // empty' <<< "$st")
staged=$(jq -r '[.deployments[]? | select(.staged)][0].version // empty' <<< "$st")
apps='[]'
if compgen -G "/var/lib/djos/apps/*.json" > /dev/null; then
    apps=$(jq -s '.' /var/lib/djos/apps/*.json 2>/dev/null || echo '[]')
fi
fp=$(timeout 25 flatpak remote-ls --updates --columns=application 2>/dev/null | grep -c . || true)
checked=$(date -r /var/lib/djos/last-check +%s 2>/dev/null || echo 0)
setup=false; [ -s /etc/ostree/auth.json ] && setup=true
jq -n --arg booted "$booted" --arg staged "$staged" --argjson apps "$apps" --argjson fp "${fp:-0}" \
      --argjson checked "$checked" --argjson setup "$setup" \
      '{system: {booted: $booted, staged: $staged}, apps: $apps, flatpak: $fp, checked: $checked, setup: $setup}'
