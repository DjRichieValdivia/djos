#!/usr/bin/bash
# DJOS: conecta esta PC a las actualizaciones privadas de GitHub (una sola vez).
# El código (token de solo lectura) lo pega el usuario: no se muestra, no queda en el historial ni en la lista de
# procesos (va por la entrada estándar) y se guarda solo en /etc/ostree/auth.json, que únicamente root puede leer.
set -u

if [ "${1:-}" = --root ]; then
    user=$2
    IFS= read -r token
    install -d -m 0755 /etc/ostree
    if printf '%s' "$token" | podman login ghcr.io --authfile /etc/ostree/auth.json -u "$user" --password-stdin > /dev/null 2>&1; then
        chmod 0600 /etc/ostree/auth.json
        echo "OK"
        bootc upgrade --check 2>&1 | tail -2
        [ -s /etc/djos/apps.conf ] && /usr/libexec/djos/app-update
    fi
    exit 0
fi

pause() { echo; read -r -p "Press Enter to close this window." _; }

echo "Set up DJOS updates"
echo "==================="
echo
echo "DJOS updates come from your private GitHub image. This connects this PC to it (only once)."
echo
url="https://github.com/settings/tokens/new?scopes=read:packages&description=DJOS%20updates"
echo "1) Your browser opens GitHub with everything already filled in (only 'read:packages' is checked)."
echo "   Set Expiration to 'No expiration', click 'Generate token' at the bottom and copy the token."
echo "   (If the browser doesn't open, go to: $url )"
echo "2) Paste the token below (it will not be shown on screen)."
echo
xdg-open "$url" > /dev/null 2>&1 &
read -r -p "GitHub username: " user
read -r -s -p "Token: " token; echo
if [ -z "$user" ] || [ -z "$token" ]; then echo "Cancelled."; pause; exit 1; fi
out=$(printf '%s\n' "$token" | pkexec /usr/libexec/djos/setup-updates --root "$user")
unset token
echo
if printf '%s' "$out" | grep -q '^OK'; then
    echo "Done. DJOS will now download its updates by itself (applied when you restart)."
    printf '%s\n' "$out" | tail -n +2
else
    echo "It didn't work. Check the username and that the token has the 'read:packages' scope."
fi
pause
