#!/usr/bin/bash
# DJOS: deja discos de música (NTFS de Windows, exFAT, ext4…) siempre disponibles en /mnt/music-<nombre>, en SOLO
# LECTURA (DJOS nunca modifica la música ni Windows). Se montan solos al primer uso, sin demorar el arranque, y si
# el disco no está conectado no pasa nada. Lo que se agrega va en /etc/fstab, marcado "djos-music".
# Nunca se ofrece (ni se acepta) una partición del disco donde está Fedora.
set -u
pause() { echo; read -r -p "Press Enter to close this window." _; }

# discos donde está el sistema: los de /, /boot, /boot/efi, /home y /var (subiendo por LUKS, LVM o RAID hasta
# el disco físico). findmnt -v: sin el "[/subvolumen]" de btrfs. lsblk -l: en lista (en árbol, el disco sale como
# "└─/dev/nvme2n1" y nunca coincidía: se ofrecían las particiones de Fedora)
system_disks() {
    local m src
    for m in / /boot /boot/efi /home /var; do
        src=$(findmnt -nvo SOURCE "$m" 2> /dev/null | head -1)
        case "$src" in /dev/*) ;; *) continue ;; esac
        lsblk -lnspo NAME,TYPE "$src" 2> /dev/null | awk '$2 == "disk" {print $1}'
    done | sort -u
}
# candidatos: particiones con un sistema de archivos conocido, de 2 GB o más, fuera de los discos del sistema.
# Salida: dispositivo, UUID, tipo, tamaño, disco, etiqueta (separados por \x1f: la etiqueta puede tener espacios)
candidates() {
    local sys
    sys=$(system_disks | tr '\n' ' ')
    lsblk -Jlpbo NAME,UUID,FSTYPE,SIZE,PKNAME,LABEL,TYPE 2> /dev/null | jq -r --arg sys " $sys " '
        .blockdevices[]
        | select(.type == "part" and .uuid != null and .pkname != null)
        | select(.fstype // "" | test("^(ntfs|ntfs3|exfat|vfat|ext4|xfs|btrfs)$"))
        | select((.size // 0) >= 2000000000)
        | select(.pkname as $pk | $sys | contains(" " + $pk + " ") | not)
        | [.name, .uuid, .fstype, (.size | tostring), .pkname, (.label // "")] | join("\u001f")'
}
human() { numfmt --to=iec --suffix=B "$1" 2> /dev/null || echo "$1 bytes"; }

if [ "${1:-}" = --root ]; then
    shift
    uidn=${1:-}; gidn=${2:-}; shift 2 || exit 2
    case "$uidn$gidn" in ''|*[!0-9]*) echo "Invalid user." >&2; exit 2 ;; esac
    ok=$(candidates | awk -F '\x1f' '{print $2}')
    added=()
    for spec in "$@"; do
        uuid=${spec%%|*}; name=${spec#*|}
        # solo lo que la ventana pudo ofrecer: UUID de una partición candidata (nunca del disco del sistema) y un
        # nombre simple
        case "$uuid" in ''|*[!A-Za-z0-9-]*) echo "Skipped (invalid disk id)"; continue ;; esac
        case "$name" in ''|*[!A-Za-z0-9_.-]*) echo "Skipped (invalid name)"; continue ;; esac
        grep -qxF "$uuid" <<< "$ok" || { echo "Skipped: $uuid is not a music disk candidate"; continue; }
        fs=$(blkid -s TYPE -o value "/dev/disk/by-uuid/$uuid" 2> /dev/null)
        dir="/mnt/music-$name"
        grep -q "^UUID=$uuid " /etc/fstab && { echo "Already set up: $dir"; continue; }
        # solo lectura de verdad: montados "ro", ext4, xfs y btrfs igual reescriben su diario si el disco quedó sucio
        # (un corte de luz, desenchufado sin expulsar); noload/norecovery/nologreplay lo evitan. NTFS (ntfs3), exFAT y
        # FAT en solo lectura no escriben nada
        case "$fs" in
            ntfs|ntfs3) type=ntfs3; opts="ro,uid=$uidn,gid=$gidn,umask=022,windows_names" ;;
            exfat) type=exfat; opts="ro,uid=$uidn,gid=$gidn,umask=022" ;;
            vfat) type=vfat; opts="ro,uid=$uidn,gid=$gidn,umask=022" ;;
            ext4) type=ext4; opts="ro,noload" ;;
            xfs) type=xfs; opts="ro,norecovery" ;;
            btrfs) type=btrfs; opts="ro,rescue=nologreplay" ;;
            *) echo "Skipped (unsupported file system '$fs')"; continue ;;
        esac
        mkdir -p "$dir"
        echo "UUID=$uuid $dir $type $opts,nofail,noauto,x-systemd.automount,x-systemd.idle-timeout=0,x-systemd.device-timeout=5s 0 0 # djos-music" >> /etc/fstab
        echo "Set up: $dir"
        added+=("$dir")
    done
    systemctl daemon-reload
    for dir in "${added[@]}"; do
        systemctl start "$(systemd-escape -p --suffix=automount "$dir")" 2> /dev/null
    done
    exit 0
fi

echo "Set up music disks"
echo "=================="
echo
echo "Your music disks will always be available (read-only: DJOS never changes your music or Windows)."
echo
args=()
while IFS=$'\x1f' read -r dev uuid fs size _disk label; do
    [ -n "$uuid" ] || continue
    name=$(printf '%s' "${label:-$uuid}" | tr -c 'A-Za-z0-9_.-' '_' | cut -c1-32)
    args+=("$uuid|$name" "${label:-no name} — $(human "$size") $fs ($dev)" off)
done < <(candidates)
if [ ${#args[@]} -eq 0 ]; then echo "No other disks found."; pause; exit 0; fi
sel=$(kdialog --title "DJOS" --separate-output --checklist "Choose your music disks:" "${args[@]}") || exit 0
[ -n "$sel" ] || exit 0
mapfile -t picked <<< "$sel"
pkexec /usr/libexec/djos/setup-music-disk --root "$(id -u)" "$(id -g)" "${picked[@]}"
echo
echo "Done. Your music is in /mnt (e.g. /mnt/music-…). In Richie DJ: Browse > Explorer, or 'Add music folder'."
pause
