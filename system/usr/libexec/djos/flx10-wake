#!/usr/bin/python3
# DJOS: saca el "NO AUDIO DRIVER" de las pantallas de los jogs de la Pioneer DDJ-FLX10 (2b73:0041).
# La consola lo muestra ~3 s después de conectarse si la PC no le habla con el protocolo del fabricante. Alcanza con
# una lectura (SOLO LECTURA: no se le escribe nada): la de su versión de firmware, una "control transfer" de tipo
# vendor (bmRequestType 0xC0, bRequest 0x00, wValue 0, wIndex 0xC001, wLength 2) -> p. ej. 01 14 = firmware 1.14.
# Lo corre udev al conectarla (91-djos-flx10.rules, como root). A mano: sudo /usr/libexec/djos/flx10-wake -v
# Fuente: lo que hace el driver de Windows, documentado en github.com/elvetemedve/nixos-desktop (flx10-wake.c).
import ctypes, fcntl, glob, os, sys, time

VID, PID = 0x2B73, 0x0041
verbose = "-v" in sys.argv[1:]


def log(msg):
    if verbose:
        print("flx10-wake: " + msg, file=sys.stderr)


class CtrlTransfer(ctypes.Structure):   # struct usbdevfs_ctrltransfer (linux/usbdevice_fs.h)
    _fields_ = [("bRequestType", ctypes.c_uint8), ("bRequest", ctypes.c_uint8), ("wValue", ctypes.c_uint16),
                ("wIndex", ctypes.c_uint16), ("wLength", ctypes.c_uint16), ("timeout", ctypes.c_uint32),
                ("data", ctypes.c_void_p)]


# _IOWR('U', 0, struct usbdevfs_ctrltransfer)
USBDEVFS_CONTROL = (3 << 30) | (ctypes.sizeof(CtrlTransfer) << 16) | (ord("U") << 8) | 0


def is_flx10(path):
    try:
        with open(path, "rb") as f:
            d = f.read(18)   # usbfs da primero el descriptor del dispositivo
    except OSError:
        return False
    return len(d) == 18 and d[1] == 0x01 and int.from_bytes(d[8:10], "little") == VID and int.from_bytes(d[10:12], "little") == PID


def wake(path):
    buf = (ctypes.c_uint8 * 2)()
    ct = CtrlTransfer(0xC0, 0x00, 0x0000, 0xC001, 2, 500, ctypes.cast(buf, ctypes.c_void_p))
    fd = os.open(path, os.O_RDWR | os.O_CLOEXEC)
    try:
        fcntl.ioctl(fd, USBDEVFS_CONTROL, ct)
    finally:
        os.close(fd)
    log(f"{path} -> firmware {buf[0]}.{buf[1]:02x}")


def main():
    paths = [a for a in sys.argv[1:] if not a.startswith("-")]
    if not paths and os.environ.get("BUSNUM") and os.environ.get("DEVNUM"):   # desde udev
        paths = [f"/dev/bus/usb/{int(os.environ['BUSNUM']):03d}/{int(os.environ['DEVNUM']):03d}"]
    if not paths:
        paths = [p for p in sorted(glob.glob("/dev/bus/usb/*/*")) if is_flx10(p)]
    if not paths:
        log("no DDJ-FLX10 found")
        return 1
    ok = True
    for p in paths:
        for i in range(3):
            try:
                wake(p)
                break
            except OSError as e:
                log(f"{p}: {e}")
                time.sleep(0.05)
        else:
            ok = False
    return 0 if ok else 1


sys.exit(main())
