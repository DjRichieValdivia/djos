class WaveView(QWidget):
    """Toda la onda del tema: 3 bandas, lo ya escuchado más apagado, la línea de lo que suena. Clic = saltar.
    La onda se dibuja una vez en dos imágenes (normal y apagada); cada cuadro solo las pega y pone la línea."""
    seekRequested = Signal(float)

    def __init__(self):
        super().__init__()
        self.setMinimumHeight(120)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.setMouseTracking(True)
        self.setCursor(Qt.PointingHandCursor)
        self.low = self.mid = self.high = None
        self.progress = 0.0     # cuánto de la onda ya está calculado
        self.duration = 0.0
        self.pos = 0.0
        self.hover = -1
        self.message = ""
        self.pix = self.pix_dim = None

    def clear(self, message=""):
        self.low = self.mid = self.high = None
        self.progress = 0.0
        self.pos = 0.0
        self.message = message
        self.pix = self.pix_dim = None
        self.update()

    def set_final(self, low, mid, high, duration):
        self.low = [v / 255 for v in low]
        self.mid = [v / 255 for v in mid]
        self.high = [v / 255 for v in high]
        self.progress = 1.0
        if duration > 0:
            self.duration = duration
        self.message = ""
        self._render()

    def set_partial(self, low, mid, high, frac):
        pl, pm, ph = band_peaks(low, mid, high)
        self.low = [min(1.0, (v / pl) ** 0.8) for v in low]
        self.mid = [min(1.0, (v / pm) ** 0.8) for v in mid]
        self.high = [min(1.0, (v / ph) ** 0.8) for v in high]
        self.progress = frac
        self.message = ""
        self._render()

    def set_pos(self, pos):
        if abs(pos - self.pos) > 1e-3:
            self.pos = pos
            self.update()

    def resizeEvent(self, e):
        if self.low is not None:
            self._render()
        super().resizeEvent(e)

    def _render(self):
        dpr = self.devicePixelRatioF()
        pw, ph = max(1, int(self.width() * dpr)), max(1, int(self.height() * dpr))
        n = len(self.low)
        mid_y = ph / 2
        amp = ph / 2 - 6 * dpr
        cols = []
        for x in range(pw):
            i0 = int(x * n / pw)
            i1 = max(i0 + 1, int((x + 1) * n / pw))
            if i0 >= n:
                break
            cols.append((max(self.low[i0:i1]), max(self.mid[i0:i1]), max(self.high[i0:i1])))
        imgs = []
        for alpha in (255, 105):
            pix = QPixmap(pw, ph)
            pix.fill(QColor(11, 13, 16))
            p = QPainter(pix)
            p.setPen(QPen(QColor(255, 255, 255, 18), 1))
            p.drawLine(0, int(mid_y), pw, int(mid_y))
            for band, c, scale in ((0, C_LOW, 1.0), (1, C_MID, 0.7), (2, C_HIGH, 0.42)):
                col = QColor(c)
                col.setAlpha(alpha)
                p.setPen(QPen(col, 1))
                for x, v in enumerate(cols):
                    hh = v[band] * amp * scale
                    if hh >= 0.5:
                        p.drawLine(QPointF(x + 0.5, mid_y - hh), QPointF(x + 0.5, mid_y + hh))
            if self.progress < 1.0:   # lo que falta calcular
                p.fillRect(QRectF(self.progress * pw, 0, pw - self.progress * pw, ph), QColor(11, 13, 16, 200))
            p.end()
            pix.setDevicePixelRatio(dpr)
            imgs.append(pix)
        self.pix, self.pix_dim = imgs
        self.update()

    def mousePressEvent(self, e):
        if e.button() == Qt.LeftButton and self.duration > 0:
            x = min(max(0.0, e.position().x()), self.width())
            self.seekRequested.emit(x / max(1, self.width()) * self.duration)

    def mouseMoveEvent(self, e):
        self.hover = int(e.position().x())
        self.update()

    def leaveEvent(self, e):
        self.hover = -1
        self.update()

    def paintEvent(self, e):
        p = QPainter(self)
        w, h = self.width(), self.height()
        if self.pix is None:
            p.fillRect(self.rect(), QColor(11, 13, 16))
            p.setPen(C_DIM)
            p.drawText(self.rect(), Qt.AlignCenter, self.message or "")
            p.end()
            return
        played_x = min(w, self.pos / self.duration * w) if self.duration > 0 else 0
        dpr = self.pix.devicePixelRatio()
        px = played_x * dpr
        # lo ya escuchado, apagado (como rekordbox); el resto, normal
        if played_x > 0:
            p.drawPixmap(QRectF(0, 0, played_x, h), self.pix_dim, QRectF(0, 0, px, self.pix.height()))
        p.drawPixmap(QRectF(played_x, 0, w - played_x, h), self.pix,
                     QRectF(px, 0, self.pix.width() - px, self.pix.height()))
        if self.duration > 0:
            p.fillRect(QRectF(played_x - 1, 0, 2, h), C_ORANGE)
        if 0 <= self.hover < w and self.duration > 0:
            p.setPen(QPen(QColor(255, 255, 255, 90), 1))
            p.drawLine(self.hover, 0, self.hover, h)
            t = fmt_time(self.hover / w * self.duration)
            p.setPen(C_TEXT)
            r = QRectF(min(self.hover + 6, w - 60), 4, 56, 18)
            p.fillRect(r, QColor(0, 0, 0, 150))
            p.drawText(r, Qt.AlignCenter, t)
        p.end()


def glyph(name, color):
    """Íconos de reproducir, pausa, anterior y siguiente dibujados acá (iguales con cualquier tema de íconos)"""
    from PySide6.QtGui import QPolygonF
    s = 64
    pix = QPixmap(s, s)
    pix.fill(Qt.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.Antialiasing)
    p.setPen(Qt.NoPen)
    p.setBrush(color)
    if name == "media-playback-start":
        p.drawPolygon(QPolygonF([QPointF(20, 12), QPointF(54, 32), QPointF(20, 52)]))
    elif name == "media-playback-pause":
        p.drawRoundedRect(QRectF(16, 12, 11, 40), 3, 3)
        p.drawRoundedRect(QRectF(37, 12, 11, 40), 3, 3)
    elif name == "media-skip-forward":
        p.drawPolygon(QPolygonF([QPointF(12, 14), QPointF(42, 32), QPointF(12, 50)]))
        p.drawRoundedRect(QRectF(44, 14, 8, 36), 2, 2)
    else:   # media-skip-backward
        p.drawPolygon(QPolygonF([QPointF(52, 14), QPointF(22, 32), QPointF(52, 50)]))
        p.drawRoundedRect(QRectF(12, 14, 8, 36), 2, 2)
    p.end()
    return QIcon(pix)


