def enum_name(v):
    """nombre de un valor de enum de Qt (QAudio y QtAudio son el mismo enum con dos nombres según la versión)"""
    return getattr(v, "name", str(v).rsplit(".", 1)[-1])


def fmt_time(sec):
    sec = max(0, int(sec))
    return f"{sec // 60}:{sec % 60:02d}"


IONICE = shutil.which("ionice")


def idle_io(args, cls="3"):
    """el comando con la E/S en reposo (clase 3) o en "best effort" bajo (clase 2, nivel 7), si hay ionice"""
    if not IONICE:
        return args
    return [IONICE, "-c", cls] + (["-n", "7"] if cls == "2" else []) + args


def low_priority():
    """Para los ffmpeg de las ondas: lo más bajo posible (el audio de un set nunca espera por esto)."""
    try:
        os.nice(10)
        os.sched_setscheduler(0, os.SCHED_IDLE, os.sched_param(0))
    except (OSError, AttributeError):
        pass


def batch_priority():
    """Para el ffmpeg que decodifica lo que se escucha: baja, pero no tanto como para cortarse con la PC ocupada."""
    try:
        os.nice(5)
        os.sched_setscheduler(0, os.SCHED_BATCH, os.sched_param(0))
    except (OSError, AttributeError):
        pass


def set_playing():
    """gig-guard: ¿está sonando un set (Richie DJ tiene pedida latencia mínima al procesador)?"""
    if not os.access(GIG_GUARD, os.X_OK):
        return False
    try:
        return subprocess.run([GIG_GUARD], capture_output=True, timeout=3).returncode != 0
    except Exception:
        return False


# --- etiquetas ----------------------------------------------------------------------------------------------------
def _first(v):
    if v is None:
        return ""
    if isinstance(v, (list, tuple)):
        v = v[0] if v else ""
    if isinstance(v, bytes):
        v = v.decode("utf-8", "replace")
    return str(v).strip()


def read_tags(path):
    """título, artista, BPM, tono, duración, formato; con mutagen (rápido) o, si no, con ffprobe."""
    info = {"title": "", "artist": "", "bpm": "", "key": "", "duration": 0.0, "format": ""}
    ext = os.path.splitext(path)[1].lower().lstrip(".").upper()
    if mutagen:
        try:
            f = mutagen.File(path)
            if f is not None:
                t = f.tags or {}
                keys = {k.lower() if isinstance(k, str) else k: k for k in getattr(t, "keys", lambda: [])()}

                def get(*names):
                    for n in names:
                        k = keys.get(n.lower())
                        if k is not None:
                            try:
                                v = t[k]
                            except Exception:
                                continue
                            v = getattr(v, "text", v)
                            s = _first(v)
                            if s:
                                return s
                    return ""
                info["title"] = get("TIT2", "title", "\xa9nam")
                info["artist"] = get("TPE1", "artist", "\xa9ART", "albumartist", "aART")
                bpm = get("TBPM", "bpm", "tmpo")
                info["key"] = get("TKEY", "initialkey", "key", "----:com.apple.iTunes:initialkey",
                                  "----:com.apple.iTunes:KEY", "TXXX:INITIALKEY")
                try:
                    b = float(bpm)
                    info["bpm"] = f"{b:.0f}" if abs(b - round(b)) < 0.05 else f"{b:.1f}"
                except ValueError:
                    info["bpm"] = ""
                i = f.info
                info["duration"] = float(getattr(i, "length", 0) or 0)
                br = int(getattr(i, "bitrate", 0) or 0)
                sr = int(getattr(i, "sample_rate", 0) or 0)
                bits = int(getattr(i, "bits_per_sample", 0) or 0)
                parts = [ext]
                if ext in ("FLAC", "WAV", "WAVE", "AIFF", "AIF", "AIFC", "ALAC", "WV", "APE"):
                    if bits:
                        parts.append(f"{bits}-bit")
                elif br:
                    parts.append(f"{round(br / 1000)} kbps")
                if sr:
                    parts.append(f"{sr / 1000:g} kHz")
                info["format"] = " · ".join(parts)
                if info["duration"] > 0:
                    return info
        except Exception:
            pass
    try:
        out = subprocess.run(["ffprobe", "-v", "error", "-print_format", "json", "-show_format", "-show_streams",
                              "-select_streams", "a:0", path], capture_output=True, text=True, timeout=15).stdout
        d = json.loads(out or "{}")
        fm = d.get("format", {})
        tags = {k.lower(): v for k, v in (fm.get("tags") or {}).items()}
        st = (d.get("streams") or [{}])[0]
        tags.update({k.lower(): v for k, v in (st.get("tags") or {}).items() if k.lower() not in tags})
        info["title"] = info["title"] or tags.get("title", "")
        info["artist"] = info["artist"] or tags.get("artist", "")
        info["bpm"] = info["bpm"] or tags.get("tbpm", tags.get("bpm", ""))
        info["key"] = info["key"] or tags.get("tkey", tags.get("initialkey", tags.get("key", "")))
        info["duration"] = info["duration"] or float(fm.get("duration") or st.get("duration") or 0)
        if not info["format"]:
            br = int(fm.get("bit_rate") or 0)
            sr = int(st.get("sample_rate") or 0)
            info["format"] = " · ".join([ext] + ([f"{round(br / 1000)} kbps"] if br else [])
                                        + ([f"{sr / 1000:g} kHz"] if sr else []))
    except Exception:
        pass
    return info


def name_guess(path):
    """sin etiquetas: "01 Artista - Título.mp3" → (artista, título)"""
    import re
    base = re.sub(r"^\s*\d{1,3}[\s._-]+", "", os.path.splitext(os.path.basename(path))[0])
    if " - " in base:
        a, t = base.split(" - ", 1)
        return a.strip(), t.strip()
    return "", base.strip()


def with_names(path, info):
    if not info.get("title"):
        a, t = name_guess(path)
        info["title"] = t
        info["artist"] = info.get("artist") or a
    return info


# --- la onda --------------------------------------------------------------------------------------------------------
# graves (< 200 Hz), medios (200-2500 Hz) y agudos (> 2500 Hz) de una mezcla mono a 22 kHz; ffmpeg rectifica y baja la
# envolvente a ENV_RATE muestras por segundo (float, 3 canales)
WAVE_GRAPH = ("[0:a:0]aformat=sample_fmts=fltp:channel_layouts=mono,aresample=22050,asplit=3[a][b][c];"
              "[a]lowpass=f=200,lowpass=f=200[l];[b]highpass=f=200,lowpass=f=2500[m];[c]highpass=f=2500[h];"
              "[l][m][h]join=inputs=3:channel_layout=3.0,aeval=abs(val(0))|abs(val(1))|abs(val(2)):c=same,"
              f"aresample={ENV_RATE}[o]")


def cache_path(path):
    try:
        st = os.stat(path)
    except OSError:
        return ""
    key = hashlib.sha1(f"{os.path.realpath(path)}\0{st.st_size}\0{st.st_mtime_ns}".encode()).hexdigest()
    return os.path.join(CACHE, key[:2], key + ".wf")


def load_wave(path):
    """(low, mid, high: bytes de BINS valores 0-255, duración) desde la caché, o None."""
    cp = cache_path(path)
    try:
        with open(cp, "rb") as f:
            data = f.read()
        if data[:6] != b"DJWF1\0" or len(data) != 6 + 4 + 8 + 3 * BINS:
            return None
        n, dur = struct.unpack("<Id", data[6:18])
        if n != BINS:
            return None
        b = data[18:]
        return bytes(b[:BINS]), bytes(b[BINS:2 * BINS]), bytes(b[2 * BINS:]), dur
    except OSError:
        return None


def save_wave(path, low, mid, high, dur):
    cp = cache_path(path)
    if not cp:
        return
    try:
        os.makedirs(os.path.dirname(cp), exist_ok=True)
        tmp = cp + f".{os.getpid()}.tmp"
        with open(tmp, "wb") as f:
            f.write(b"DJWF1\0" + struct.pack("<Id", BINS, dur) + bytes(low) + bytes(mid) + bytes(high))
        os.replace(tmp, cp)
    except OSError:
        pass


def band_peaks(low, mid, high):
    """escala de cada banda: su propio pico, pero nunca menos que una parte del pico del tema (medios 1/2, agudos 1/3):
    unos agudos bajitos quedan chicos, como en rekordbox, y unos fuertes llenan su franja"""
    top = max(max(low), max(mid), max(high), 1e-6)
    return max(max(low), 1e-6), max(max(mid), top / 2), max(max(high), top / 3)


class WaveJob:
    """Calcula la onda de un tema con ffmpeg; llama a progress(low, mid, high, fracción) mientras avanza (floats sin
    normalizar) y devuelve los bytes 0-255 al final. cancel() lo corta."""

    def __init__(self, path, duration):
        self.path = path
        self.duration = duration
        self.proc = None
        self.cancelled = False

    def cancel(self):
        self.cancelled = True
        p = self.proc
        if p and p.poll() is None:
            try:
                p.kill()
            except OSError:
                pass

    def run(self, progress=None):
        dur = self.duration
        if dur <= 0:
            dur = read_tags(self.path)["duration"]
        if dur <= 0 or self.cancelled:
            return None
        total = dur * ENV_RATE
        per_bin = max(1.0, total / BINS)
        low = [0.0] * BINS
        mid = [0.0] * BINS
        high = [0.0] * BINS
        try:
            self.proc = subprocess.Popen(idle_io(["ffmpeg", "-v", "error", "-nostdin", "-threads", "1", "-i", self.path,
                                                  "-filter_complex", WAVE_GRAPH, "-map", "[o]", "-f", "f32le", "-"]),
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, preexec_fn=low_priority)
        except OSError:
            return None
        n = 0          # muestras (de 3 canales) leídas
        rest = b""
        last = time.monotonic()
        while not self.cancelled:
            chunk = self.proc.stdout.read(3 * 4 * 4096)
            if not chunk:
                break
            chunk = rest + chunk
            cut = len(chunk) - len(chunk) % 12
            rest = chunk[cut:]
            a = array.array("f")
            a.frombytes(chunk[:cut])
            if sys.byteorder != "little":
                a.byteswap()
            cnt = len(a) // 3
            # por columna: el máximo de cada banda
            i = 0
            while i < cnt:
                b = int((n + i) / per_bin)
                if b >= BINS:
                    b = BINS - 1
                end = min(cnt, int((b + 1) * per_bin) - n)
                if end <= i:
                    end = i + 1
                seg = a[3 * i:3 * end]
                lo = max(seg[0::3])
                mi = max(seg[1::3])
                hi = max(seg[2::3])
                if lo > low[b]:
                    low[b] = lo
                if mi > mid[b]:
                    mid[b] = mi
                if hi > high[b]:
                    high[b] = hi
                i = end
            n += cnt
            now = time.monotonic()
            if progress and now - last > 0.08:
                last = now
                progress(low, mid, high, min(1.0, n / total))
        self.proc.stdout.close()
        self.proc.wait()
        if self.cancelled or n == 0:
            return None
        pl, pm, ph = band_peaks(low, mid, high)

        def q(v, peak):
            return bytes(min(255, int(255 * (x / peak) ** 0.8)) for x in v)
        res = (q(low, pl), q(mid, pm), q(high, ph), n / ENV_RATE)
        save_wave(self.path, *res)
        return res


# --- el audio -------------------------------------------------------------------------------------------------------
class Decoder:
    """PCM de un tema (48 kHz, 16 bits, estéreo) en memoria, decodificado por ffmpeg en un hilo desde un cuadro dado.
    Tiene [base, base + len(buf)/FRAME); más allá se vuelve a arrancar ffmpeg con -ss."""

    def __init__(self):
        self.lock = threading.Condition()
        self.path = None
        self.base = 0
        self.buf = bytearray()
        self.done = False
        self.error = ""
        self.proc = None
        self.gen = 0
        self.want = 0          # cuadro que está sonando (para no decodificar de más)

    def stop(self):
        with self.lock:
            self.gen += 1
            p = self.proc
            self.proc = None
            self.lock.notify_all()
        if p and p.poll() is None:
            try:
                p.kill()
            except OSError:
                pass

    def open(self, path, frame=0):
        self.stop()
        with self.lock:
            self.path = path
            self.base = frame
            self.buf = bytearray()
            self.done = False
            self.error = ""
            self.want = frame
            gen = self.gen
        args = ["ffmpeg", "-v", "error", "-nostdin"]
        if frame > 0:
            args += ["-ss", f"{frame / RATE:.3f}"]
        args += ["-i", path, "-map", "0:a:0", "-vn", "-f", "s16le", "-acodec", "pcm_s16le", "-ac", "2",
                 "-ar", str(RATE), "-"]
        try:
            p = subprocess.Popen(idle_io(args, "2"), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                 preexec_fn=batch_priority)
        except OSError as e:
            with self.lock:
                self.done = True
                self.error = str(e)
            return
        with self.lock:
            self.proc = p
        threading.Thread(target=self._pump, args=(p, gen), daemon=True).start()

    def _pump(self, p, gen):
        while True:
            with self.lock:
                # no más de AHEAD por delante de lo que suena
                while gen == self.gen and (self.base * FRAME + len(self.buf)) - self.want * FRAME > AHEAD:
                    self.lock.wait(0.5)
                if gen != self.gen:
                    break
            chunk = p.stdout.read(65536)
            with self.lock:
                if gen != self.gen:
                    break
                if not chunk:
                    self.done = True
                    try:
                        err = p.stderr.read().decode("utf-8", "replace").strip()
                    except Exception:
                        err = ""
                    if not self.buf and err:
                        self.error = err.splitlines()[-1]
                    self.lock.notify_all()
                    break
                self.buf += chunk
                # lo que ya sonó hace rato se tira (mixes largos)
                drop = (self.want - self.base) * FRAME - 60 * RATE * FRAME
                if len(self.buf) > KEEP and drop > 0:
                    drop -= drop % FRAME
                    del self.buf[:drop]
                    self.base += drop // FRAME
                self.lock.notify_all()
        try:
            p.stdout.close()
        except OSError:
            pass

    def covers(self, frame):
        """¿se puede tocar desde ese cuadro sin volver a arrancar ffmpeg? (hasta 2 s más allá de lo decodificado)"""
        with self.lock:
            end = self.base + len(self.buf) // FRAME
            if self.done:
                return self.base <= frame
            return self.base <= frame <= end + 2 * RATE

    def read(self, frame, nbytes):
        """(bytes, fin): lo que hay desde 'frame'; b"" y fin=False si todavía no llegó (el que llama pone silencio)"""
        with self.lock:
            self.want = frame
            self.lock.notify_all()
            off = (frame - self.base) * FRAME
            if off < 0:
                return b"", False
            data = bytes(self.buf[off:off + nbytes])
            end = self.done and off + len(data) >= len(self.buf)
            return data, end


class PcmDevice(QIODevice):
    """De dónde saca el audio la salida (modo "pull"): del Decoder, desde player.frame."""

    def __init__(self, player):
        super().__init__()
        self.player = player

    def isSequential(self):
        return True

    def bytesAvailable(self):
        return 1 << 20

    def readData(self, maxlen):
        pl = self.player
        maxlen -= maxlen % FRAME
        if maxlen <= 0:
            return b""
        data, end = pl.dec.read(pl.frame, maxlen)
        if data:
            pl.frame += len(data) // FRAME
            if pl.t_play:
                log(f"audio: first samples {(time.monotonic() - pl.t_play) * 1000:.0f} ms after play")
                pl.t_play = 0
            return data
        if end:
            pl.ended = True
            return b""
        # todavía decodificando (recién elegido o recién saltado): unos milisegundos de silencio
        n = min(maxlen, RATE // 50 * FRAME)
        return bytes(n)

    def writeData(self, data):
        return 0


class Player(QObject):
    """Reproduce un tema por la salida normal del escritorio. Pausar suelta la salida (PipeWire puede dormir la placa
    y Richie DJ tomarla); volver a tocar la abre de nuevo en milisegundos."""
    stateChanged = Signal()
    failed = Signal(str)

    def __init__(self):
        super().__init__()
        self.dec = Decoder()
        self.path = None
        self.frame = 0          # próximo cuadro que se le entrega a la salida
        self.ended = False
        self.playing = False
        self.sink = None
        self.dev = None
        self.duration = 0.0
        self.t_play = 0
        self.fmt = None
        if QAudioSink is not None:
            self.fmt = QAudioFormat()
            self.fmt.setSampleRate(RATE)
            self.fmt.setChannelCount(2)
            self.fmt.setSampleFormat(QAudioFormat.SampleFormat.Int16)
        self.endTimer = QTimer(self)
        self.endTimer.setInterval(100)
        self.endTimer.timeout.connect(self._check_end)

    def load(self, path, duration=0.0):
        """Elige un tema: empieza a decodificarlo ya (así Espacio suena al instante). Si estaba sonando, sigue."""
        was = self.playing
        self._release()
        self.path = path
        self.duration = duration
        self.frame = 0
        self.ended = False
        self.dec.open(path, 0)
        if was:
            self.play()
        self.stateChanged.emit()

    def position(self):
        """segundos de lo que se está escuchando (lo entregado menos lo que espera en el buffer de la salida)"""
        f = self.frame
        if self.sink is not None and self.playing:
            try:
                f -= max(0, self.sink.bufferSize() - self.sink.bytesFree()) // FRAME
            except RuntimeError:
                pass
        return max(0.0, f / RATE)

    def _release(self):
        if self.sink is not None:
            pos = self.position()
            try:
                self.sink.stop()
            except RuntimeError:
                pass
            self.sink.deleteLater()
            self.sink = None
            self.frame = int(pos * RATE)
        if self.dev is not None:
            self.dev.close()
            self.dev.deleteLater()
            self.dev = None
        self.endTimer.stop()
        self.playing = False

    def play(self):
        if not self.path:
            return
        if QAudioSink is None:
            self.failed.emit("Sound output is not available (QtMultimedia is missing).")
            return
        if self.ended or (self.duration > 0 and self.frame >= int(self.duration * RATE) - RATE // 10):
            self.seek(0.0)
        if not self.dec.covers(self.frame):
            self.dec.open(self.path, self.frame)
        dev = QMediaDevices.defaultAudioOutput()
        if dev.isNull():
            log("play: no default audio output")
            self.failed.emit("No sound output found.")
            return
        self.ended = False
        self.t_play = time.monotonic()
        self.dev = PcmDevice(self)
        self.dev.open(QIODevice.OpenModeFlag.ReadOnly)
        self.sink = QAudioSink(dev, self.fmt, self)
        self.sink.setBufferSize(RATE * FRAME * BUFFER_MS // 1000)
        self.sink.start(self.dev)
        log(f"play {os.path.basename(self.path)} at {self.frame / RATE:.1f} s on '{dev.description()}': "
            f"state {self.sink.state()}, error {self.sink.error()}, buffer {self.sink.bufferSize()} bytes")
        if enum_name(self.sink.error()) != "NoError":
            err = self.sink.error()
            self._release()
            self.failed.emit(f"The sound output could not be opened ({err}).")
            return
        self.playing = True
        self.endTimer.start()
        self.stateChanged.emit()

    def pause(self):
        self._release()
        self.stateChanged.emit()

    def toggle(self):
        if self.playing:
            self.pause()
        else:
            self.play()

    def seek(self, sec):
        if not self.path:
            return
        if self.duration > 0:
            sec = min(sec, max(0.0, self.duration - 0.05))
        sec = max(0.0, sec)
        was = self.playing
        if was:
            self._release()
        self.frame = int(sec * RATE)
        self.ended = False
        if not self.dec.covers(self.frame):
            self.dec.open(self.path, self.frame)
        if was:
            self.play()
        self.stateChanged.emit()

    def _check_end(self):
        if self.ended and self.sink is not None:
            if self.sink.bytesFree() >= self.sink.bufferSize() - FRAME * 64 or \
                    enum_name(self.sink.state()) in ("IdleState", "StoppedState"):
                self._release()
                self.frame = 0
                self.ended = False
                self.stateChanged.emit()

    def close(self):
        self._release()
        self.dec.stop()


