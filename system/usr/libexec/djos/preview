    # --- abrir -----------------------------------------------------------------------------------------------------
    def open_paths(self, paths):
        paths = [os.path.abspath(p) for p in paths if p]
        paths = [p for p in paths if os.path.exists(p)]
        if not paths:
            return False
        select = None
        if len(paths) == 1 and os.path.isdir(paths[0]):
            folder = paths[0]
            files = self.scan(folder)
        elif len(paths) == 1:
            folder = os.path.dirname(paths[0])
            files = self.scan(folder)
            select = paths[0]
            if select not in files:
                files.insert(0, select)
        else:   # varios elegidos en Dolphin: esos (y los de las carpetas elegidas)
            files = []
            for p in paths:
                files += self.scan(p) if os.path.isdir(p) else ([p] if self.is_audio(p) else [])
            folder = os.path.dirname(files[0]) if files else os.path.dirname(paths[0])
            select = files[0] if files else None
        self.set_files(folder, files, select, autoplay=select is not None)
        return True

    @staticmethod
    def is_audio(p):
        return os.path.splitext(p)[1].lower() in AUDIO_EXT and not os.path.basename(p).startswith("._")

    def scan(self, folder):
        try:
            names = os.listdir(folder)
        except OSError:
            return []

        def natural(s):
            import re
            return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]
        return [os.path.join(folder, n) for n in sorted(names, key=natural)
                if self.is_audio(n) and os.path.isfile(os.path.join(folder, n))]

    def set_files(self, folder, files, select=None, autoplay=False):
        self.prefetch_stop.set()
        self.list_gen += 1
        self.folder = folder
        self.files = files
        self.tags = {}
        self.list.blockSignals(True)
        self.list.clear()
        for i, f in enumerate(files):
            it = QTreeWidgetItem([str(i + 1), os.path.splitext(os.path.basename(f))[0], "", "", "", "", ""])
            it.setData(0, Qt.UserRole, i)
            for c in (0, 3, 4, 5):
                it.setTextAlignment(c, Qt.AlignRight | Qt.AlignVCenter)
            self.list.addTopLevelItem(it)
        self.list.blockSignals(False)
        self.setWindowTitle(f"{os.path.basename(folder) or folder} — {APP}")
        save_config({"folder": folder})
        if not files:
            self.current = -1
            self.player.close()
            self.wave.clear("No audio files here. Drop a folder on this window or use Open folder… (Ctrl+O)."
                            if folder else "Open a folder with tracks (Ctrl+O)")
            self.lbl_title.setText("DJOS Preview")
            self.lbl_artist.setText(folder)
            self.refresh_state()
            return
        # etiquetas de todos, en segundo plano (el elegido primero)
        idx = files.index(select) if select in files else 0
        gen = self.list_gen
        order = [idx] + [i for i in range(len(files)) if i != idx]

        def tagger():
            for i in order:
                if gen != self.list_gen:
                    return
                self.tagsReady.emit(gen, files[i], with_names(files[i], read_tags(files[i])))
        threading.Thread(target=tagger, daemon=True).start()
        self.explicit = autoplay
        self.autoplay = autoplay
        self.list.setCurrentItem(self.list.topLevelItem(idx))
        self.list.setFocus()

    def choose_folder(self):
        start = self.folder or music_dir()
        d = QFileDialog.getExistingDirectory(self, "Open a folder with tracks", start)
        if d:
            self.open_paths([d])

    def dragEnterEvent(self, e):
        if e.mimeData().hasUrls():
            e.acceptProposedAction()

    def dropEvent(self, e):
        self.open_paths([u.toLocalFile() for u in e.mimeData().urls() if u.isLocalFile()])

    # --- elegir un tema ----------------------------------------------------------------------------------------------
    def on_current(self, item, _prev):
        if item is None:
            return
        i = item.data(0, Qt.UserRole)
        if i is None or i == self.current:
            return
        self.current = i
        path = self.files[i]
        t = self.tags.get(path) or {}
        self.show_info(path, t)
        autoplay = getattr(self, "autoplay", False)
        self.autoplay = False
        if autoplay and self.gig and not self.player.playing:
            self.show_banner("A set is playing: DJOS Preview doesn't start by itself. Press Space to listen anyway "
                             "(it plays on the desktop sound output).")
            autoplay = False
        was = self.player.playing
        self.player.load(path, t.get("duration", 0.0))
        if autoplay and not was:
            self.player.play()
        self.start_wave(path, t.get("duration", 0.0))
        self.refresh_state()

    def show_info(self, path, t):
        self.lbl_title.setText(t.get("title") or os.path.splitext(os.path.basename(path))[0])
        self.lbl_artist.setText(t.get("artist") or os.path.basename(os.path.dirname(path)))
        self.chip_bpm.set(f"{t['bpm']} BPM" if t.get("bpm") else "")
        self.chip_key.set(t.get("key", ""))
        self.chip_fmt.set(t.get("format", ""))

    def on_tags(self, gen, path, t):
        if gen != self.list_gen:
            return
        self.tags[path] = t
        try:
            i = self.files.index(path)
        except ValueError:
            return
        it = self.list.topLevelItem(i)
        if t.get("title"):
            it.setText(1, t["title"])
        it.setText(2, t.get("artist", ""))
        it.setText(3, t.get("bpm", ""))
        it.setText(4, t.get("key", ""))
        it.setText(5, fmt_time(t["duration"]) if t.get("duration") else "")
        it.setText(6, t.get("format", ""))
        if i == self.current:
            self.show_info(path, t)
            if t.get("duration") and not self.player.duration:
                self.player.duration = t["duration"]
            if t.get("duration") and not self.wave.duration:
                self.wave.duration = t["duration"]
        if len(self.tags) == len(self.files):
            self.start_prefetch()

    def step(self, d):
        if not self.files:
            return
        i = min(max(0, (self.current if self.current >= 0 else 0) + d), len(self.files) - 1)
        self.list.setCurrentItem(self.list.topLevelItem(i))

    # --- la onda -------------------------------------------------------------------------------------------------------
    def start_wave(self, path, duration):
        if self.wave_job:
            self.wave_job.cancel()
            self.wave_job = None
        self.wave.duration = duration
        self.t_wave = time.monotonic()
        cached = load_wave(path)
        if cached:
            lo, mi, hi, dur = cached
            self.wave.set_final(lo, mi, hi, dur or duration)
            self.player.duration = self.player.duration or dur
            self.wave_ms = (time.monotonic() - self.t_wave) * 1000
            log(f"wave cached {self.wave_ms:.0f} ms: {os.path.basename(path)}")
            return
        self.wave.clear("Reading the waveform…")
        job = WaveJob(path, duration)
        self.wave_job = job
        first = [True]

        def prog(lo, mi, hi, frac):
            if first[0]:
                first[0] = False
                log(f"wave first paint {(time.monotonic() - self.t_wave) * 1000:.0f} ms: {os.path.basename(path)}")
            self.waveProgress.emit(path, list(lo), list(mi), list(hi), frac)

        def work():
            res = job.run(prog)
            self.waveDone.emit(path, res)
        threading.Thread(target=work, daemon=True).start()

    def on_wave_progress(self, path, lo, mi, hi, frac):
        if self.current >= 0 and self.files[self.current] == path:
            self.wave.set_partial(lo, mi, hi, frac)

    def on_wave_done(self, path, res):
        if not (self.current >= 0 and self.files[self.current] == path):
            return
        if res:
            lo, mi, hi, dur = res
            self.wave.set_final(lo, mi, hi, self.wave.duration or dur)
            if not self.player.duration:
                self.player.duration = dur
            log(f"wave done {(time.monotonic() - self.t_wave) * 1000:.0f} ms: {os.path.basename(path)}")
        elif self.wave.low is None:
            self.wave.clear("Could not read this file.")

    def start_prefetch(self):
        """con todas las etiquetas leídas: las ondas del resto de la carpeta, de a una, a la menor prioridad (así
        moverse con las flechas las muestra al instante). Nunca mientras suena un set."""
        self.prefetch_stop.set()
        stop = threading.Event()
        self.prefetch_stop = stop
        files = list(self.files)
        tags = dict(self.tags)

        def work():
            time.sleep(1.5)
            for f in files:
                if stop.is_set():
                    return
                if self.gig or load_wave(f):
                    continue
                if self.wave_job and self.wave_job.path == f:
                    continue
                job = WaveJob(f, (tags.get(f) or {}).get("duration", 0.0))
                self.prefetch_job = job
                job.run()
            log("prefetch done")
        threading.Thread(target=work, daemon=True).start()

    # --- reproducir -----------------------------------------------------------------------------------------------------
    def toggle(self):
        if self.player.playing:
            self.player.pause()
        else:
            self.play_explicit()

    def play_explicit(self):
        if self.current < 0 and self.files:
            self.step(0)
        self.explicit = True
        self.banner.hide()
        self.player.play()

    def seek_to(self, sec):
        self.player.seek(sec)
        self.wave.set_pos(sec)

    def seek_by(self, d):
        self.seek_to(self.player.position() + d)

    def eventFilter(self, obj, e):
        if obj is self.list and e.type() == e.Type.KeyPress:
            k = e.key()
            if k == Qt.Key_Space:
                self.toggle()
                return True
            if k in (Qt.Key_Left, Qt.Key_Right):
                self.seek_by((30 if e.modifiers() & Qt.ShiftModifier else 5) * (1 if k == Qt.Key_Right else -1))
                return True
            if Qt.Key_1 <= k <= Qt.Key_9 and self.player.duration > 0:
                self.seek_to(self.player.duration * (k - Qt.Key_0) / 10)
                return True
            if k == Qt.Key_Home:
                self.seek_to(0)
                return True
        return super().eventFilter(obj, e)

    def keyPressEvent(self, e):
        k = e.key()
        if k == Qt.Key_Space:
            self.toggle()
        elif k in (Qt.Key_Up, Qt.Key_Down):
            self.step(1 if k == Qt.Key_Down else -1)
        elif k in (Qt.Key_Left, Qt.Key_Right):
            self.seek_by((30 if e.modifiers() & Qt.ShiftModifier else 5) * (1 if k == Qt.Key_Right else -1))
        else:
            super().keyPressEvent(e)

    def tick(self):
        pos = self.player.position()
        self.wave.set_pos(pos)
        dur = self.player.duration or self.wave.duration
        self.lbl_time.setText(f"{fmt_time(pos)} / {fmt_time(dur)}")

    def check_gig(self):
        was = self.gig
        self.gig = set_playing()
        if self.gig and not was:
            self.prefetch_stop.set()
            if self.player.playing:
                # empezó un set mientras sonaba la vista previa: se para (y suelta la salida de audio)
                self.player.pause()
                self.show_banner("A set started playing: the preview stopped. Press Space to listen anyway.")
        elif was and not self.gig:
            self.banner.hide()
            if len(self.tags) == len(self.files) and self.files:
                self.start_prefetch()

    def show_banner(self, text):
        self.banner.setText(text)
        self.banner.show()

    def refresh_state(self):
        self.btn_play.setIcon(glyph("media-playback-pause" if self.player.playing else "media-playback-start",
                                    QColor(20, 10, 2)))

    def closeEvent(self, e):
        self.prefetch_stop.set()
        if self.wave_job:
            self.wave_job.cancel()
        self.player.close()
        super().closeEvent(e)


def music_dir():
    try:
        d = subprocess.run(["xdg-user-dir", "MUSIC"], capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:
        d = ""
    return d if d and os.path.isdir(d) else os.path.expanduser("~")


def load_config():
    try:
        with open(CONFIG, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_config(d):
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        cur = load_config()
        cur.update(d)
        with open(CONFIG + ".tmp", "w", encoding="utf-8") as f:
            json.dump(cur, f)
        os.replace(CONFIG + ".tmp", CONFIG)
    except OSError:
        pass


T0 = time.monotonic()


def log(msg):
    if os.environ.get("DJOS_PREVIEW_DEBUG"):
        print(f"[{(time.monotonic() - T0) * 1000:7.0f} ms] {msg}", file=sys.stderr, flush=True)


def dark_palette(app):
    """Los colores de DJOS (DJOS.colors) también fuera de Plasma"""
    pal = QPalette()
    for role, c in ((QPalette.Window, C_BG), (QPalette.WindowText, C_TEXT), (QPalette.Base, C_VIEW),
                    (QPalette.AlternateBase, C_VIEW_ALT), (QPalette.Text, C_TEXT), (QPalette.Button, QColor(32, 37, 44)),
                    (QPalette.ButtonText, C_TEXT), (QPalette.Highlight, C_ORANGE), (QPalette.HighlightedText, QColor(20, 10, 2)),
                    (QPalette.ToolTipBase, QColor(28, 32, 39)), (QPalette.ToolTipText, C_TEXT),
                    (QPalette.PlaceholderText, C_DIM), (QPalette.Link, C_ORANGE)):
        pal.setColor(role, c)
    pal.setColor(QPalette.Disabled, QPalette.Text, C_DIM)
    pal.setColor(QPalette.Disabled, QPalette.WindowText, C_DIM)
    pal.setColor(QPalette.Disabled, QPalette.ButtonText, C_DIM)
    app.setPalette(pal)


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    paths = [QUrl(a).toLocalFile() if a.startswith("file:") else a for a in args]
    try:
        os.nice(5)   # la ventana también, un poco por debajo de lo normal
    except OSError:
        pass
    app = QApplication(sys.argv[:1])
    app.setApplicationName(APP)
    app.setOrganizationName("DJOS")
    app.setDesktopFileName("org.djos.preview")
    if not QIcon.themeName() or QIcon.themeName() == "hicolor":
        QIcon.setThemeName("Papirus-Dark")
    dark_palette(app)

    # una sola ventana: si ya hay una abierta, se le pasan los archivos y esta se cierra
    name = f"djos-preview-{os.getuid()}"
    sock = QLocalSocket()
    sock.connectToServer(name)
    if sock.waitForConnected(300):
        sock.write(json.dumps(paths or []).encode() + b"\n")
        sock.waitForBytesWritten(1000)
        sock.disconnectFromServer()
        return 0
    QLocalServer.removeServer(name)
    server = QLocalServer()
    server.listen(name)

    w = Window()

    def incoming():
        c = server.nextPendingConnection()
        if c is None:
            return

        def got():
            if not c.canReadLine():
                return
            try:
                ps = json.loads(bytes(c.readLine()).decode())
            except ValueError:
                ps = []
            if ps:
                w.open_paths(ps)
            w.showNormal()
            w.raise_()
            w.activateWindow()
            c.disconnectFromServer()
        c.readyRead.connect(got)
    server.newConnection.connect(incoming)

    w.show()
    if not (paths and w.open_paths(paths)):
        last = load_config().get("folder")
        w.open_paths([last if last and os.path.isdir(last) else music_dir()])
    log("window shown")
    rc = app.exec()
    server.close()
    return rc


if __name__ == "__main__":
    if not shutil.which("ffmpeg"):
        print("djos preview: ffmpeg is missing (sudo dnf install ffmpeg-free)", file=sys.stderr)
    sys.exit(main())
