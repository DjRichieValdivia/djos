#!/usr/bin/bash
# DJOS: aspecto del escritorio de cada usuario. Lo corre djos-desktop.service (de usuario) en cada inicio de sesión:
#   1. una sola vez por usuario y versión del diseño (V): tema DJOS Glass (V3 en DJOS 2.3; V4 en 2.4: el dock de DJOS
#      con la lupa, el Launchpad arriba a la izquierda, paneles transparentes y menús redondeados; colores, íconos,
#      ventanas, pantalla de carga), barra de arriba, dock y fondo, favoritos del menú, pantalla de bloqueo, perfil
#      de Konsole, avisos en pantalla completa. Si después el usuario cambia algo, se respeta (solo se vuelve a aplicar
#      si sube V). El tema clásico (org.djos.desktop, V2) sigue en el selector de temas
#   2. Richie DJ fijo en la barra cuando la app llega después (una vez; si el usuario lo saca, se respeta)
#   3. la barra en la pantalla principal (una vez; hasta DJOS 2.2.0 podía quedar en la secundaria)
#   4. retoques de la barra (una vez cada uno): la bandeja sin el clima (2.2.2) y el menú con la grilla de apps (2.2.4)
#   5. las ventanas con el semáforo (una vez: la 2.3.0 dejaba la decoración de fábrica de KWin), y los mismos botones
#      en las apps que dibujan los suyos (Chrome, GTK: una vez, 2.3.3)
#   6. display-setup: cada monitor nuevo a su frecuencia más alta
# Para volver al escritorio de Fedora: plasma-apply-lookandfeel -a org.fedoraproject.fedora.desktop --resetLayout
set -u
V=4
state=${XDG_STATE_HOME:-$HOME/.local/state}/djos
cfg=${XDG_CONFIG_HOME:-$HOME/.config}
data=${XDG_DATA_HOME:-$HOME/.local/share}
lnf=/usr/share/plasma/look-and-feel/org.djos.glass
layout=$lnf/contents/layouts/org.kde.plasma.desktop-layout.js
rdj_desktop=/usr/local/share/applications/richiedj.desktop
marker=$state/desktop-v$V
mkdir -p "$state"

# favoritos del menú (IDs de Fedora 44; Richie DJ aunque todavía no esté: aparece cuando se instala)
FAVORITES="richiedj.desktop org.djos.center.desktop org.mozilla.firefox.desktop org.kde.dolphin.desktop
    org.kde.konsole.desktop systemsettings.desktop org.kde.discover.desktop"

# corre un script de la barra adentro de Plasma (el mismo mecanismo que usa Configuración)
plasma_script() {
    local script
    script=$(cat "$1") || return 1
    busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$script" > /dev/null 2>&1 \
        || gdbus call --session --dest org.kde.plasmashell --object-path /PlasmaShell \
               --method org.kde.PlasmaShell.evaluateScript "$script" > /dev/null 2>&1
}

plasma_ready() {
    local _
    for _ in $(seq 1 90); do   # Plasma recién arrancando
        busctl --user status org.kde.plasmashell > /dev/null 2>&1 && { sleep 2; return 0; }
        sleep 1
    done
    return 1
}

# archivo de autoarranque apagado solo para este usuario (el del sistema es de otro paquete y no se toca); si el
# usuario ya tiene el suyo, se respeta
autostart_off() {
    local f=$cfg/autostart/$1
    [ -e "/etc/xdg/autostart/$1" ] || [ "${2:-}" = always ] || return 0
    [ -e "$f" ] && return 0
    mkdir -p "$cfg/autostart" && printf '[Desktop Entry]\nType=Application\nName=%s\nHidden=true\n' "${1%.desktop}" > "$f"
}

# ventanas: el tema deja la decoración en ~/.config/kdedefaults y los botones vienen de /etc/xdg/kwinrc (a la derecha,
# como en Windows; el tema no los puede cambiar). Lo que el usuario tenga en su propio kwinrc tapa las dos cosas (y el selector de temas
# ya no podría cambiar la decoración): se saca del archivo. A mano, no con "kwriteconfig6 --delete": eso deja marcas
# "clave[$d]" que tapan también los valores de abajo y KWin vuelve a los suyos de fábrica (le pasó a la 2.3.0)
# avisa a KDE que cambiaron claves de un archivo de configuración (la señal de "kwriteconfig6 --notify", sin escribir
# nada): gtkconfig pasa la posición de los botones a GTK (Chrome, Firefox y las apps GTK dibujan los suyos) y el portal
# se la da a las apps Flatpak. Las claves van como bytes exactos ("b'...'" de gdbus agrega un 0 al final y no coincide)
kconfig_notify() {   # kconfig_notify <archivo> <grupo> <clave>...
    local file=$1 group=$2 k
    shift 2
    local args=()
    for k in "$@"; do
        # shellcheck disable=SC2207 # un número por byte
        args+=("${#k}" $(printf '%s' "$k" | od -An -tu1))
    done
    busctl --user emit "/$file" org.kde.kconfig.notify ConfigChanged 'a{saay}' 1 "$group" "$#" "${args[@]}" > /dev/null 2>&1
}

kwin_deco_reset() {
    local f=$cfg/kwinrc
    [ -f "$f" ] || return 0
    python3 - "$f" <<'PY' || return 1
import sys
p = sys.argv[1]
keys = ("library", "theme", "ButtonsOnLeft", "ButtonsOnRight")
out, group, changed = [], None, False
with open(p, encoding="utf-8", errors="surrogateescape") as fh:
    for line in fh:
        if line.startswith("["):
            group = line.strip()
        elif group == "[org.kde.kdecoration2]" and line.split("=", 1)[0].strip().split("[", 1)[0] in keys:
            changed = True
            continue
        out.append(line)
if changed:
    with open(p, "w", encoding="utf-8", errors="surrogateescape") as fh:
        fh.writelines(out)
PY
    busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure > /dev/null 2>&1
    kconfig_notify kwinrc org.kde.kdecoration2 ButtonsOnLeft ButtonsOnRight library theme
    return 0
}

apply_look() {
    # tema global: colores, íconos, estilo de ventanas y pantalla de carga (la barra va aparte)
    plasma-apply-lookandfeel -a org.djos.glass > /dev/null 2>&1
    plasma-apply-colorscheme DJOSGlass > /dev/null 2>&1
    # tema de Plasma: paneles transparentes (el dock dibuja el suyo) y menús redondeados
    plasma-apply-desktoptheme djos-glass > /dev/null 2>&1
    # ventanas con el semáforo: la decoración del tema y los botones de DJOS (una vez, con el diseño nuevo)
    kwin_deco_reset
    if [ -x /usr/libexec/plasma-changeicons ]; then
        /usr/libexec/plasma-changeicons Papirus-Dark-DJOS > /dev/null 2>&1
    else
        kwriteconfig6 --file kdeglobals --group Icons --key Theme Papirus-Dark-DJOS
    fi

    # favoritos del menú: los de DJOS en vez de los de fábrica (Plasma los guarda en la base de datos de
    # actividades; el menú nuevo que arma la barra los lee de ahí)
    # shellcheck disable=SC2086 # una palabra por favorito
    python3 - "$data/kactivitymanagerd/resources/database" $FAVORITES <<'PY' 2> /dev/null
import os, sqlite3, sys
db, favs = sys.argv[1], sys.argv[2:]
if os.path.exists(db):
    c = sqlite3.connect(db, timeout=10)
    agent = "org.kde.plasma.favorites.applications"
    c.execute("DELETE FROM ResourceLink WHERE initiatingAgent = ?", (agent,))
    c.executemany("INSERT OR IGNORE INTO ResourceLink (usedActivity, initiatingAgent, targettedResource) VALUES (':global', ?, ?)",
                  [(agent, "applications:" + f) for f in favs])
    c.commit()
PY

    # barra de arriba, dock y fondo (el diseño del tema DJOS Glass)
    plasma_script "$layout" || return 1
    # la barra nueva ya trae el ícono de actualizaciones, y Richie DJ si ya estaba instalado
    [ -e "$rdj_desktop" ] && touch "$state/richiedj-pinned"
    touch "$state/updates-widget-added"

    # orden de los favoritos en el menú nuevo (se ve desde el próximo inicio de sesión; Plasma guarda la barra nueva
    # en su archivo unos segundos después)
    sleep 8
    local kick order client
    # el último menú de apps de la barra: el Launchpad (kickerdash, mismo código que kicker) o el menú de siempre
    kick=$(awk -F'[][]' '/^\[Containments\]\[[0-9]+\]\[Applets\]\[[0-9]+\]$/ { id = $8 } /^plugin=org.kde.plasma.(kickoff|kicker|kickerdash)$/ && id { last = id; p = $0 } END { if (last) print last, p }' \
           "$cfg/plasma-org.kde.plasma.desktop-appletsrc" 2> /dev/null)
    if [ -n "$kick" ]; then
        case "$kick" in *kickoff) client=org.kde.plasma.kickoff ;; *) client=org.kde.plasma.kicker ;; esac
        # shellcheck disable=SC2086
        order=$(printf '%s\n' $FAVORITES | paste -sd, -)
        kwriteconfig6 --file kactivitymanagerd-statsrc --group "Favorites-$client.favorites.instance-${kick%% *}-global" \
            --key ordering "$order"
    fi
    # la bandeja nueva sin el clima (recién ahora la bandeja tiene su lista)
    plasma_script /usr/share/djos/panel-tweaks.js

    # pantalla de bloqueo con el fondo de DJOS Glass
    kwriteconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin org.kde.image
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General \
        --key Image "file:///usr/share/wallpapers/DJOS-Glass/"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General \
        --key PreviewImage "file:///usr/share/wallpapers/DJOS-Glass/"

    # Konsole con el perfil DJOS (el konsolerc del sistema es del paquete de Konsole: va por usuario)
    kwriteconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile DJOS.profile

    # sin avisos encima de Richie DJ en pantalla completa (el plasmanotifyrc del sistema es de Plasma)
    kwriteconfig6 --file plasmanotifyrc --group DoNotDisturb --key WhenFullscreen --type bool true

    # sin ubicación automática ni la carga de la configuración de NVIDIA para X11 (en Wayland no hace nada)
    autostart_off geoclue-demo-agent.desktop
    autostart_off nvidia-settings-user.desktop always
    # sin los recordatorios de calendario de KDE al iniciar: arrancan Akonadi entero (el motor de KMail/KOrganizer, con
    # su base de datos MySQL y ~15 procesos, más de 1 GB de RAM) aunque nadie use correo ni agenda, y queda trabajando
    # de fondo en pleno set. Si se abre KMail o KOrganizer, Akonadi arranca igual
    autostart_off org.kde.kalendarac.desktop
    return 0
}

# Dolphin (una vez por usuario, DJOS 2.2): las carpetas se abren en vista de detalles con tamaño y fecha (una carpeta
# de música se lee como una lista, no como íconos grandes). Es el valor por defecto de Dolphin para las carpetas que
# todavía no tienen uno propio; si el usuario ya eligió uno (el archivo existe), se respeta. Las columnas de título,
# artista o duración necesitarían el indexador Baloo, que DJOS deja apagado (le compite al audio en pleno set)
dolphin_details() {
    local f=$data/dolphin/view_properties/global/.directory
    [ -e "$state/dolphin-details-v1" ] && return 0
    if [ ! -e "$f" ]; then
        mkdir -p "${f%/*}" && printf '[Dolphin]\nVersion=4\nViewMode=1\nVisibleRoles=Details_text,Details_size,Details_modificationtime\n' > "$f"
    fi
    touch "$state/dolphin-details-v1"
}
dolphin_details

# Richie DJ llegó después del escritorio: a la barra (y al menú, por si Plasma lo sacó de los favoritos)
pin_richiedj() {
    plasma_script /usr/share/djos/pin-richiedj.js || return 1
    busctl --user call org.kde.ActivityManager /ActivityManager/Resources/Linking \
        org.kde.ActivityManager.ResourcesLinking LinkResourceToActivity sss \
        org.kde.plasma.favorites.applications applications:richiedj.desktop :global > /dev/null 2>&1
    touch "$state/richiedj-pinned"
}

# la 2.3.0 dejó marcas "[$d]" en el kwinrc de cada usuario (ventanas con la decoración de fábrica de KWin, sin el
# semáforo): se limpian una vez (no necesita Plasma)
if [ -e "$marker" ] && [ ! -e "$state/kwin-deco-v1" ]; then
    kwin_deco_reset && touch "$state/kwin-deco-v1"
fi
# los botones de las apps que dibujan los suyos (Chrome, GTK) seguían a la izquierda después de la 2.3.2: GTK los
# copia de KWin solo cuando le avisan que cambiaron. Una vez (si kded todavía no arrancó, el aviso no le llega: vuelve
# a probar en el próximo inicio de sesión hasta que GTK los tenga igual que KWin)
gtk_buttons() {
    local want have
    want=$(kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight)
    kconfig_notify kwinrc org.kde.kdecoration2 ButtonsOnLeft ButtonsOnRight
    sleep 2
    have=$(sed -n 's/^gtk-decoration-layout=//p' "$cfg/gtk-3.0/settings.ini" 2> /dev/null)
    # IAX → ":minimize,maximize,close" (lo único que DJOS pone); con otro orden elegido a mano no hay nada que esperar
    [ "$want" != IAX ] || [ "$have" = ":minimize,maximize,close" ]
}
if [ -e "$marker" ] && [ ! -e "$state/gtk-buttons-v1" ]; then
    gtk_buttons && touch "$state/gtk-buttons-v1"
fi

# la barra de DJOS (hasta 2.2.0) se armaba en la pantalla del cursor: a la principal, una sola vez. Con un solo
# monitor no hay nada que mover; si después el usuario la pasa a otra pantalla, se respeta
panel_primary=$state/panel-primary-v1
if [ -e "$marker" ] && [ ! -e "$panel_primary" ] && \
   [ "$(kscreen-doctor -j 2> /dev/null | jq '[.outputs[] | select(.enabled and .connected)] | length' 2> /dev/null)" = 1 ]; then
    touch "$panel_primary"
fi

# retoques de la barra (panel-tweaks.js, menu-icon.js): también después de armar la barra nueva, que recién ahí
# tiene la bandeja
panel_tweaks=$state/panel-tweaks-v1
menu_icon=$state/menu-icon-v3

if [ ! -e "$marker" ] || [ ! -e "$panel_primary" ] || [ ! -e "$panel_tweaks" ] || [ ! -e "$menu_icon" ] || \
   { [ ! -e "$state/richiedj-pinned" ] && [ -e "$rdj_desktop" ]; }; then
    if plasma_ready; then
        if [ ! -e "$marker" ]; then
            # el diseño nuevo ya pone las barras en la principal, sin el clima y con su propio ícono de menú
            apply_look && touch "$marker" "$panel_primary" "$panel_tweaks" "$menu_icon" "$state/kwin-deco-v1"
        fi
        if [ -e "$marker" ] && [ ! -e "$panel_primary" ]; then
            plasma_script /usr/share/djos/panel-to-primary.js && touch "$panel_primary"
        fi
        if [ -e "$marker" ] && [ ! -e "$panel_tweaks" ]; then
            plasma_script /usr/share/djos/panel-tweaks.js && touch "$panel_tweaks"
        fi
        if [ -e "$marker" ] && [ ! -e "$menu_icon" ]; then
            plasma_script /usr/share/djos/menu-icon.js && touch "$menu_icon"
        fi
        if [ -e "$marker" ] && [ ! -e "$state/richiedj-pinned" ] && [ -e "$rdj_desktop" ]; then
            pin_richiedj
        fi
    fi
fi

exec /usr/libexec/djos/display-setup
