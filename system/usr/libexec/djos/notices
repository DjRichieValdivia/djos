#!/usr/bin/bash
# DJOS: avisos importantes al iniciar sesión (con explicación de qué hacer)
#   - Secure Boot sin autorizar la clave del driver de NVIDIA: gráficos básicos y un solo monitor
#   - hay una placa NVIDIA pero su driver no está cargado (no se instaló, o no se pudo compilar para este núcleo)
#   - una controladora Pioneer conectada cuya placa de sonido Linux no maneja (también al enchufarla:
#     "notices controllers", desde djos-controller-check.service)
set -u

controller_notice() {   # p. ej. DDJ-FLX10: su MIDI anda, su audio necesita el modo compatible de DJOS Center
    local ctl name
    ctl=$(/usr/libexec/djos/controller-audio status 2> /dev/null)
    name=$(jq -r '[.[]? | select(.audio == false)][0].name // empty' <<< "${ctl:-[]}" 2> /dev/null)
    [ -n "$name" ] || return 0
    notify-send -a DJOS -i audio-card "Set up the audio of your $name" \
        "Its MIDI already works. DJOS can try a compatible mode for its sound card: open DJOS Center > Audio."
}
if [ "${1:-}" = controllers ]; then controller_notice; exit 0; fi

nv=$(/usr/libexec/djos/nvidia-setup --status 2> /dev/null)
if [ -n "$nv" ] && [ "$(jq -r '.gpu' <<< "$nv" 2> /dev/null)" = true ]; then
    if [ "$(jq -r '.mok_pending' <<< "$nv")" = true ]; then
        notify-send -a DJOS -u critical -i video-display \
            "Finish setting up the NVIDIA graphics driver" \
            "Until then the PC uses basic graphics and only one monitor.
Restart the PC: on the blue screen choose Enroll MOK → Continue → Yes, type the password djosdjos and choose Reboot.
(Or turn off Secure Boot in the BIOS.)"
    elif [ -z "$(jq -r '.driver // empty' <<< "$nv")" ]; then
        # akmods compila el driver para cada núcleo nuevo al arrancar; si falló (o todavía no se instaló)
        notify-send -a DJOS -u critical -i video-display \
            "The NVIDIA graphics driver is not running" \
            "The PC is using basic graphics (only one monitor). Open Konsole and run:
sudo /usr/libexec/djos/nvidia-setup
It installs or rebuilds the driver. If it can't, restart and choose the previous kernel in the boot menu (press Esc while the PC starts)."
    fi
fi

controller_notice

exit 0
