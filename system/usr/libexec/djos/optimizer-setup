#!/usr/bin/bash
# DJOS Optimizer: ajustes de la PC para DJ encima de Fedora KDE. Lo corre el paquete djos-optimizer:
#   install     primera instalación (%post, $1 == 1): todo lo de abajo, y además apaga servicios que una PC de DJ
#               no usa, enmascara kaccess y nvidia-powerd y le pone nombre a la PC
#   upgrade     actualización del paquete (%post, $1 >= 2): vuelve a aplicar lo mismo sin pisar lo que el usuario
#               cambió después (servicios que volvió a prender, otra pantalla de arranque, otro nombre, argumentos del
#               núcleo que sacó, usuarios que sacó de los grupos de audio); solo agrega lo que la versión trae nuevo
#   posttrans   al final de la transacción (%posttrans): copia los valores de KDE a /etc/xdg y rearma el initramfs si
#               cambió lo de DJOS que va adentro (pantalla de arranque, opciones de módulos)
#   remove      desinstalación (%preun, $1 == 0): deja Fedora como estaba (el initramfs lo rearma después el %postun
#               del paquete, cuando los archivos ya no están: /run/djos-optimizer-initramfs), borra las imágenes de
#               podman que bajó DJOS y deja a cada usuario con el escritorio de DJOS la vuelta al de Fedora
#   cleanup     saca paquetes que una PC de DJ no necesita (bootstrap/install.sh lo pregunta antes); frena si
#               sacarlos arrastrara algo esencial
#   groups      (djos-users.service) usuarios nuevos a los grupos audio y pipewire
#   --dry-run   muestra qué haría, sin tocar nada
# Todo es idempotente y nunca devuelve error en install/upgrade/posttrans/remove (un %preun que falla deja el
# paquete a medio sacar).
set -u

STATE=/var/lib/djos
SHARE=/usr/share/djos
KARGS="preempt=full threadirqs usbcore.autosuspend=-1"
PPD=/etc/tuned/ppd.conf
PPD_TPL=$SHARE/tuned/ppd.conf
GRUB_CFG=/boot/grub2/grub.cfg                      # en Fedora 44 es el mismo para BIOS y UEFI (el de la ESP es un puente)
THEME_DIR=/usr/share/plymouth/themes/djos
PLY_CONF=/etc/plymouth/plymouthd.conf
INITRD_REBUILD=/run/djos-optimizer-initramfs      # remove lo pide, el %postun del spec rearma el initramfs
# solo en la primera instalación (si el usuario los vuelve a prender, se respeta):
#   intel_lpmd  mueve trabajo a los núcleos de bajo consumo para ahorrar energía: pelea con la prioridad del audio
#   nfs-client  carpetas de red NFS: una PC de DJ no las usa
#   irqbalance  reparte las interrupciones entre núcleos cada 10 s: deshacía lo de djos-rtirq (la del USB de la placa
#               de sonido en un núcleo P con FIFO 90, las demás en los E) y llevaba otras a los núcleos del audio
# CUPS no se toca: en Fedora 44 ya arranca solo cuando se imprime (cups.socket), así la impresora sigue andando.
FIRST_DISABLE="intel_lpmd.service nfs-client.target irqbalance.service"
# los que llegaron a FIRST_DISABLE después: se apagan una vez al actualizar, en las PCs que ya tenían DJOS
#   (2.5.2) irqbalance
UPGRADE_DISABLE="irqbalance.service"
# enmascarados (también solo al instalar):
#   nvidia-powerd  ahorro de energía de laptops con NVIDIA (en una de escritorio solo llena el registro de errores)
#   plasma-kaccess (del usuario) teclas especiales de accesibilidad: evita que Shift apretado 5 veces en pleno set
#                  active "teclas lentas/pegajosas"
FIRST_MASK="nvidia-powerd.service"
FIRST_MASK_USER="plasma-kaccess.service"

DRY=0
log() { echo "djos: $*"; }
warn() { echo "djos: warning: $*" >&2; }
run() {   # run <comando…>: lo corre, o en --dry-run lo muestra
    if [ "$DRY" = 1 ]; then echo "  would run: $*"; return 0; fi
    "$@"
}
runq() {   # runq <comando…>: igual, pero sin mostrar lo que el comando escribe
    if [ "$DRY" = 1 ]; then echo "  would run: $*"; return 0; fi
    "$@" > /dev/null 2>&1
}
live() { [ -d /run/systemd/system ]; }   # sistema arrancado de verdad (no un chroot ni un contenedor de armado)
have() { command -v "$1" > /dev/null 2>&1; }
mark() {   # mark <archivo de estado> [contenido]
    [ "$DRY" = 1 ] && return 0
    mkdir -p "$STATE" && chmod 0755 "$STATE"
    printf '%s\n' "${2:-}" > "$STATE/$1"
}
list_add() {   # list_add <archivo de estado> <renglón>: agrega sin repetir
    [ "$DRY" = 1 ] && return 0
    mkdir -p "$STATE"
    grep -qxF -- "$2" "$STATE/$1" 2> /dev/null || printf '%s\n' "$2" >> "$STATE/$1"
}

# palabras (argumentos del núcleo): agregar las que faltan / sacar las indicadas, sin repetir ni reordenar el resto.
# La salida lleva un solo espacio entre palabras (ni dobles ni al principio o al final)
words_add() {
    local -a now add; local out w
    read -ra now <<< "$1"
    out="${now[*]}"
    read -ra add <<< "$2"
    for w in "${add[@]}"; do
        read -ra now <<< "$out"
        case " ${now[*]} " in *" $w "*) ;; *) out="${out:+$out }$w" ;; esac
    done
    printf '%s' "$out"
}
words_del() {
    local -a list; local out="" w
    read -ra list <<< "$1"
    for w in "${list[@]}"; do
        case " $2 " in *" $w "*) ;; *) out="${out:+$out }$w" ;; esac
    done
    printf '%s' "$out"
}

# --- grupos: tiempo real para Richie DJ, DAWs y PipeWire (límites en /etc/security/limits.d/95-djos-audio.conf)
human_users() { awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ {print $1}' /etc/passwd; }
# cada usuario una sola vez (anotados en /var/lib/djos/groups-done): si después alguien lo saca de un grupo, ni una
# actualización de DJOS ni un cambio en /etc/passwd lo vuelven a poner
do_groups() {   # do_groups [upgrade]
    local u g
    if [ "${1:-}" = upgrade ] && [ ! -e "$STATE/groups-done" ] && [ -e "$STATE/setup-version" ]; then
        # instalado con una versión que no lo anotaba: los usuarios que ya están ya pasaron por acá
        for u in $(human_users); do list_add groups-done "$u"; done
        return 0
    fi
    for u in $(human_users); do
        grep -qxF -- "$u" "$STATE/groups-done" 2> /dev/null && continue
        for g in audio pipewire; do
            getent group "$g" > /dev/null || continue
            id -nG "$u" 2> /dev/null | tr ' ' '\n' | grep -qx "$g" && continue
            run usermod -aG "$g" "$u" && log "$u added to group $g (takes effect at the next login)"
        done
        list_add groups-done "$u"
    done
}

# --- nombre de la PC: "djos", solo si no tiene uno elegido. Se escribe en /etc/hostname y vale desde el próximo
#     arranque (cambiarlo en caliente puede dejar sin permiso a las ventanas X de la sesión abierta)
do_hostname() {
    local cur=""
    [ -f /etc/hostname ] && cur=$(tr -d '[:space:]' < /etc/hostname)
    case "$cur" in
        ""|fedora|localhost|localhost.localdomain|localhost-live) ;;
        *) return 0 ;;
    esac
    [ "$DRY" = 1 ] && { echo "  would set the computer name to djos (was '${cur:-unset}')"; return 0; }
    if [ ! -e "$STATE/hostname.orig" ] && [ ! -e "$STATE/hostname.absent" ]; then
        mkdir -p "$STATE"
        if [ -f /etc/hostname ]; then cp -a /etc/hostname "$STATE/hostname.orig"; else : > "$STATE/hostname.absent"; fi
    fi
    echo djos > /etc/hostname && chmod 0644 /etc/hostname
    have restorecon && restorecon /etc/hostname 2> /dev/null
    log "computer name set to djos (from the next restart)"
}
undo_hostname() {
    [ "$(tr -d '[:space:]' 2> /dev/null < /etc/hostname)" = djos ] || return 0
    if [ -f "$STATE/hostname.orig" ]; then
        run cp -a "$STATE/hostname.orig" /etc/hostname
    elif [ -e "$STATE/hostname.absent" ]; then
        run rm -f /etc/hostname
    else
        return 0
    fi
    log "computer name restored"
}

# --- argumentos del núcleo. grubby (Fedora 44) los pone en todas las entradas de arranque y además en
#     /etc/kernel/cmdline (de ahí los toma cada núcleo nuevo que se instala) y en GRUB_CMDLINE_LINUX de
#     /etc/default/grub (de ahí los toma grub2-mkconfig), pero este último solo si ya tenía algo: se completa a mano
default_args() { grubby --info=DEFAULT 2> /dev/null | sed -n 's/^args="\(.*\)"$/\1/p' | head -1; }
boot_entries() { ls /boot/loader/entries/*.conf > /dev/null 2>&1; }

replace_file() {   # replace_file <archivo>: pone <archivo>.djos-new en su lugar de una vez (un corte de luz no lo deja
                    # por la mitad), con los permisos y la etiqueta de SELinux del original
    [ -f "$1" ] && chmod --reference="$1" "$1.djos-new" 2> /dev/null
    mv -f "$1.djos-new" "$1" || { rm -f "$1.djos-new"; return 1; }
    have restorecon && restorecon "$1" 2> /dev/null
    return 0
}
sync_default_grub() {   # sync_default_grub add|del <args>
    local f=/etc/default/grub cur raw new
    [ -f "$f" ] || return 0
    # se lee como lo lee grub2-mkconfig, pero sin "set -u": con él, una variable sin definir en el archivo (p. ej. el
    # GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT …" de muchas guías) cortaba la lectura, el valor quedaba
    # vacío y la línea se reescribía solo con los de DJOS (se perdían rhgb quiet, rd.luks…, el blacklist de nouveau)
    # shellcheck source=/dev/null
    if ! cur=$(set +u; . "$f" > /dev/null 2>&1 && printf '%s' "${GRUB_CMDLINE_LINUX-}"); then
        warn "$f could not be read: left as is"; return 0
    fi
    # si la línea tiene algo pero la lectura dio vacío, algo no cuadra: no se toca
    raw=$(sed -n 's/^[[:space:]]*GRUB_CMDLINE_LINUX=//p' "$f" | tail -n 1 | tr -d "\"'[:space:]")
    if [ -z "$cur" ] && [ -n "$raw" ]; then warn "GRUB_CMDLINE_LINUX in $f could not be read: left as is"; return 0; fi
    case "$cur" in *\"*|*\\*) warn "GRUB_CMDLINE_LINUX in $f has quotes: left as is"; return 0 ;; esac
    if [ "$1" = add ]; then new=$(words_add "$cur" "$2"); else new=$(words_del "$cur" "$2"); fi
    [ "$new" = "$(words_add "$cur" "")" ] && return 0
    [ "$DRY" = 1 ] && { echo "  would set GRUB_CMDLINE_LINUX=\"$new\" in $f"; return 0; }
    NEWLINE="GRUB_CMDLINE_LINUX=\"$new\"" awk 'BEGIN { l = ENVIRON["NEWLINE"] }
        /^[[:space:]]*GRUB_CMDLINE_LINUX=/ { if (!d) print l; d = 1; next }
        { print }
        END { if (!d) print l }' "$f" > "$f.djos-new" && replace_file "$f"
    rm -f "$f.djos-new"
    # /etc/kernel/cmdline no puede quedar más viejo que /etc/default/grub (si no, el próximo núcleo rearma todo)
    [ -f /etc/kernel/cmdline ] && touch /etc/kernel/cmdline
}
sync_kernel_cmdline() {   # sync_kernel_cmdline add|del <args>: la primera línea (las demás, si hay, quedan igual)
    local f=/etc/kernel/cmdline cur new
    [ -f "$f" ] || return 0
    cur=$(head -n 1 "$f")
    if [ "$1" = add ]; then new=$(words_add "$cur" "$2"); else new=$(words_del "$cur" "$2"); fi
    [ "$new" = "$(words_add "$cur" "")" ] && return 0
    [ "$DRY" = 1 ] && { echo "  would write '$new' to $f"; return 0; }
    { printf '%s\n' "$new"; tail -n +2 "$f"; } > "$f.djos-new" && replace_file "$f"
    rm -f "$f.djos-new"
}

# Anotado en /var/lib/djos: kargs-added (los que DJOS agregó: son los que saca al desinstalar), kargs-applied (los que
# DJOS ya puso alguna vez: una actualización nunca vuelve a poner uno que después se sacó a mano, p. ej. para probar
# algo con un USB o con NVIDIA; solo agrega los que una versión nueva traiga por primera vez) y kargs-replaced (lo que
# había para la misma opción antes de DJOS, p. ej. preempt=lazy: grubby lo reemplaza, y vuelve al desinstalar)
do_kargs() {   # do_kargs install|upgrade
    have grubby || { warn "grubby not found: kernel options not set"; return 0; }
    boot_entries || { log "no boot entries here (not an installed system): kernel options skipped"; return 0; }
    local def kc a old want="" missing="" need=0
    if [ "$1" = upgrade ]; then
        # instalado con una versión que no lo anotaba: esa puso todos (si falta alguno, lo sacó el usuario)
        if [ ! -e "$STATE/kargs-applied" ] && [ -e "$STATE/setup-version" ]; then
            for a in $KARGS; do list_add kargs-applied "$a"; done
        fi
        for a in $KARGS; do
            grep -qxF -- "$a" "$STATE/kargs-applied" 2> /dev/null || want="${want:+$want }$a"
        done
        [ -n "$want" ] || return 0
    else
        want=$KARGS
    fi
    def=" $(default_args) "
    kc=" $(head -n 1 /etc/kernel/cmdline 2> /dev/null) "
    for a in $want; do
        case "$def" in *" $a "*) ;; *) missing="${missing:+$missing }$a"; need=1 ;; esac
        [ -f /etc/kernel/cmdline ] && case "$kc" in *" $a "*) ;; *) need=1 ;; esac
    done
    # anotado ANTES de tocar nada: al desinstalar se saca solo lo que puso DJOS (no lo que el usuario ya tenía) y
    # vuelve lo que tenía para la misma opción
    for a in $missing; do
        list_add kargs-added "$a"
        case "$a" in *=*)
            for old in $def; do
                case "$old" in "${a%%=*}="*) [ "$old" != "$a" ] && list_add kargs-replaced "$old" ;; esac
            done ;;
        esac
    done
    if [ "$need" = 1 ]; then
        run grubby --update-kernel=ALL --args="$want" \
            && log "kernel options set: $want (take effect at the next restart)"
    fi
    sync_default_grub add "$want"
    sync_kernel_cmdline add "$want"
    for a in $want; do list_add kargs-applied "$a"; done
}
undo_kargs() {
    local added back
    added=$(tr '\n' ' ' 2> /dev/null < "$STATE/kargs-added")   # 2> primero: sin aviso si no existe
    back=$(tr '\n' ' ' 2> /dev/null < "$STATE/kargs-replaced")
    if [ -n "${added// /}" ]; then
        if have grubby && boot_entries; then
            run grubby --update-kernel=ALL --remove-args="$added" && log "kernel options removed: $added"
        fi
        sync_default_grub del "$added"
        sync_kernel_cmdline del "$added"
    fi
    if [ -n "${back// /}" ]; then   # lo que había antes de DJOS para esas mismas opciones
        if have grubby && boot_entries; then
            run grubby --update-kernel=ALL --args="$back" && log "kernel options restored: $back"
        fi
        sync_default_grub add "$back"
        sync_kernel_cmdline add "$back"
    fi
}

# --- perfiles de energía: los de Plasma (tuned-ppd) pasan a los de DJOS. /etc/tuned/ppd.conf es de tuned-ppd:
#     se guarda el original y se vuelve a poner al desinstalar
ppd_is_ours() { grep -qE '^[[:space:]]*performance[[:space:]]*=[[:space:]]*djos[[:space:]]*$' "$PPD" 2> /dev/null; }
do_tuned() {   # do_tuned install|upgrade
    [ -f "$PPD_TPL" ] || { warn "$PPD_TPL missing"; return 0; }
    local changed=0
    if [ -f "$PPD" ] && ! cmp -s "$PPD_TPL" "$PPD"; then
        # al actualizar solo se pisa si es el nuestro (de otra versión); si el usuario lo cambió a mano o volvió al de
        # Fedora (dnf reinstall tuned-ppd, lo que sugiere el aviso de abajo), se respeta
        if ppd_is_ours || [ "$1" = install ]; then
            if ! ppd_is_ours && [ ! -e "$STATE/backup/ppd.conf" ]; then
                run mkdir -p "$STATE/backup" && run cp -a "$PPD" "$STATE/backup/ppd.conf"
            fi
            run install -m 0644 "$PPD_TPL" "$PPD" && changed=1
            have restorecon && run restorecon "$PPD" 2> /dev/null
            log "power profiles mapped to the DJOS tuned profiles (Performance = djos, Balanced = djos-balanced)"
        else
            log "$PPD is not the DJOS one (changed by hand or back to Fedora's): left as is"
        fi
    elif [ ! -f "$PPD" ]; then
        log "tuned-ppd is not installed: power profile mapping skipped"
    fi
    if live && [ "$changed" = 1 ]; then
        run systemctl try-restart tuned-ppd.service 2> /dev/null
    fi
    # la primera vez arranca en Rendimiento (djos), como siempre fue DJOS; después manda el usuario
    [ "$1" = install ] || return 0
    have tuned-adm || { warn "tuned is not installed: DJOS profile not activated"; return 0; }
    if live && systemctl -q is-active tuned.service; then
        run tuned-adm profile djos && log "tuned profile: djos (Performance)"
    elif [ "$DRY" = 1 ]; then
        echo "  would write djos to /etc/tuned/active_profile (tuned not running)"
    else
        [ -f "$PPD" ] && echo performance > /etc/tuned/ppd_base_profile
        echo djos > /etc/tuned/active_profile
        echo manual > /etc/tuned/profile_mode
        log "tuned profile djos set for the next start"
    fi
}
undo_tuned() {
    local was_djos=0 restored=0 cur
    cur=$(tuned-adm active 2> /dev/null | sed -n 's/^Current active profile: //p')
    [ -n "$cur" ] || cur=$(cat /etc/tuned/active_profile 2> /dev/null)
    case "$cur" in djos*) was_djos=1 ;; esac
    if ppd_is_ours; then
        if [ -f "$PPD.rpmnew" ]; then   # tuned-ppd se actualizó mientras tanto: su versión nueva
            run mv -f "$PPD.rpmnew" "$PPD"
        elif [ -f "$STATE/backup/ppd.conf" ]; then
            run cp -a "$STATE/backup/ppd.conf" "$PPD"
        else
            warn "no backup of $PPD: reinstall tuned-ppd to get the original back (sudo dnf reinstall tuned-ppd)"
        fi
        have restorecon && run restorecon "$PPD" 2> /dev/null
        restored=1
        log "power profiles back to Fedora's"
    fi
    # los perfiles djos desaparecen con el paquete: se vuelve a "Equilibrado", lo que trae Fedora
    if [ "$was_djos" = 1 ] && [ -f /etc/tuned/ppd_base_profile ]; then
        if [ "$DRY" = 1 ]; then echo "  would write balanced to /etc/tuned/ppd_base_profile"
        else echo balanced > /etc/tuned/ppd_base_profile; fi
    fi
    if live; then
        # tuned-ppd relee el archivo y el perfil guardado solo al arrancar
        { [ "$restored" = 1 ] || [ "$was_djos" = 1 ]; } && run systemctl try-restart tuned-ppd.service 2> /dev/null
        if [ "$was_djos" = 1 ] && ! systemctl -q is-active tuned-ppd.service && systemctl -q is-active tuned.service; then
            run tuned-adm auto_profile
        fi
        [ "$was_djos" = 1 ] && log "power profile: Balanced (Fedora's default)"
    elif [ "$was_djos" = 1 ]; then
        if [ "$DRY" = 1 ]; then echo "  would set tuned back to balanced for the next start"
        else echo balanced > /etc/tuned/active_profile; echo auto > /etc/tuned/profile_mode; fi
    fi
    return 0
}

# --- servicios (apagados y enmascarados solo en la primera instalación; se anotan para devolverlos)
turn_off() {   # turn_off <servicio>: apagado y anotado (al desinstalar vuelve a lo que Fedora trae por defecto)
    local u=$1
    [ "$(systemctl is-enabled "$u" 2> /dev/null)" = enabled ] || return 0
    list_add disabled-units "$u"
    run systemctl disable --quiet "$u" && log "turned off $u"
    live && run systemctl stop "$u" 2> /dev/null
    return 0
}
do_services_upgrade() {   # una sola vez por servicio y por PC (si el usuario lo vuelve a prender, se respeta)
    local u
    for u in $UPGRADE_DISABLE; do
        [ -e "$STATE/off-${u%.service}" ] && continue
        turn_off "$u"
        mark "off-${u%.service}" 1
        # irqbalance deja las interrupciones donde las puso: djos-rtirq las vuelve a acomodar ya
        [ "$u" = irqbalance.service ] && live && run systemctl try-restart djos-rtirq.service 2> /dev/null
    done
    return 0
}
do_services_first() {
    local u
    for u in $FIRST_DISABLE; do
        turn_off "$u"
        case " $UPGRADE_DISABLE " in *" $u "*) mark "off-${u%.service}" 1 ;; esac
    done
    for u in $FIRST_MASK; do
        [ "$(systemctl is-enabled "$u" 2> /dev/null)" = masked ] && continue
        list_add masked-units "$u"
        run systemctl mask --quiet "$u" 2> /dev/null && log "masked $u"
    done
    for u in $FIRST_MASK_USER; do
        [ "$(systemctl --global is-enabled "$u" 2> /dev/null)" = masked ] && continue
        list_add masked-user-units "$u"
        run systemctl --global mask --quiet "$u" 2> /dev/null && log "masked $u (for every user)"
    done
}
undo_services() {
    local u
    while read -r u; do
        [ -n "$u" ] || continue
        [ "$(systemctl is-enabled "$u" 2> /dev/null)" = masked ] || continue
        run systemctl unmask --quiet "$u" 2> /dev/null && log "unmasked $u"
        # y lo que Fedora (o RPM Fusion) trae por defecto para ese servicio, si está instalado
        [ -f "/usr/lib/systemd/system/$u" ] && run systemctl preset --quiet "$u" 2> /dev/null
    done < <(cat "$STATE/masked-units" 2> /dev/null)
    while read -r u; do
        [ -n "$u" ] || continue
        [ "$(systemctl --global is-enabled "$u" 2> /dev/null)" = masked ] && run systemctl --global unmask --quiet "$u" 2> /dev/null
    done < <(cat "$STATE/masked-user-units" 2> /dev/null)
    # lo que DJOS apagó vuelve a lo que Fedora trae por defecto
    while read -r u; do
        [ -n "$u" ] || continue
        run systemctl preset --quiet "$u" 2> /dev/null && log "restored $u to Fedora's default"
    done < <(cat "$STATE/disabled-units" 2> /dev/null)
}

# --- pantalla de arranque djos (va dentro del initramfs: se rearma en posttrans, solo si hizo falta). También van
#     adentro las opciones de módulos de DJOS (ntsync, audio): si una versión nueva las cambia, también se rearma
theme_sum() {
    { find "$THEME_DIR" \( -type f -o -type l \) -print0 2> /dev/null | LC_ALL=C sort -z | xargs -0r cat 2> /dev/null
      cat /usr/lib/modules-load.d/djos-*.conf /usr/lib/modprobe.d/djos-*.conf 2> /dev/null
    } | md5sum | cut -d' ' -f1
}
do_plymouth() {   # do_plymouth install|upgrade
    have plymouth-set-default-theme || return 0
    [ -f "$THEME_DIR/djos.plymouth" ] || { warn "plymouth theme djos not found"; return 0; }
    local cur
    cur=$(plymouth-set-default-theme 2> /dev/null)
    if [ "$cur" != djos ]; then
        # al actualizar se respeta si el usuario eligió otra (ya se había puesto una vez)
        [ "$1" = upgrade ] && [ -e "$STATE/plymouth-set" ] && return 0
        [ -e "$STATE/plymouth-prev" ] || mark plymouth-prev "$cur"
        # /etc/plymouth/plymouthd.conf es de plymouth: copia para devolverlo tal cual
        if [ -f "$PLY_CONF" ] && [ ! -e "$STATE/backup/plymouthd.conf" ]; then
            run mkdir -p "$STATE/backup" && run cp -a "$PLY_CONF" "$STATE/backup/plymouthd.conf"
        fi
        run plymouth-set-default-theme djos || { warn "could not set the boot screen"; return 0; }
        mark plymouth-set
        mark initramfs-pending
        log "boot screen: DJOS"
    elif [ "$(cat "$STATE/plymouth-sum" 2> /dev/null)" != "$(theme_sum)" ] && [ -e "$STATE/plymouth-sum" ]; then
        mark initramfs-pending   # la pantalla cambió en esta versión
    fi
    mark plymouth-sum "$(theme_sum)"
}
rebuild_initramfs() {
    have dracut || return 0
    ls /usr/lib/modules/*/vmlinuz > /dev/null 2>&1 || { log "no kernels here: initramfs not rebuilt"; return 0; }
    log "updating the boot screen in every installed kernel (1-2 minutes)..."
    runq dracut -f --regenerate-all || { warn "dracut failed (the boot screen may stay the old one)"; return 1; }
    log "boot screen updated"
}
do_posttrans() {
    do_xdg
    [ -e "$STATE/initramfs-pending" ] || return 0
    rebuild_initramfs && run rm -f "$STATE/initramfs-pending"
    return 0
}

# --- valores por defecto de KDE en /etc/xdg (kdeglobals, kwinrc, powerdevilrc…). No son archivos del paquete: si un
#     día Fedora trae uno con el mismo nombre, rpm no choca (un choque frenaría todas las actualizaciones de Fedora).
#     Se copian desde /usr/share/djos/xdg solo si no están o si siguen tal cual los dejó DJOS (sha256 anotado en
#     /var/lib/djos/xdg-sums); lo que alguien cambió se respeta. Al actualizar DJOS va en posttrans: rpm borra los de
#     la versión anterior (que eran del paquete) después de %post. Al desinstalar se borran los que nadie cambió
XDG_SRC=$SHARE/xdg
xdg_sum() { [ -f "$1" ] && sha256sum < "$1" | cut -d' ' -f1; }
xdg_record() {   # xdg_record <nombre> [sha256]: anota lo que DJOS dejó en /etc/xdg (sin sha256: lo olvida)
    [ "$DRY" = 1 ] && return 0
    mkdir -p "$STATE"
    { awk -v f="$1" '$2 != f' "$STATE/xdg-sums" 2> /dev/null
      [ -z "${2:-}" ] || printf '%s %s\n' "$2" "$1"; } > "$STATE/xdg-sums.new" && mv -f "$STATE/xdg-sums.new" "$STATE/xdg-sums"
}
do_xdg() {
    [ -d "$XDG_SRC" ] || return 0
    local src f dst new cur old
    for src in "$XDG_SRC"/*; do
        [ -f "$src" ] || continue
        f=${src##*/}; dst=/etc/xdg/$f
        new=$(xdg_sum "$src")
        old=$(awk -v f="$f" '$2 == f {print $1}' "$STATE/xdg-sums" 2> /dev/null)
        # una versión anterior lo traía como archivo del paquete y alguien lo cambió: rpm lo guardó como .rpmsave
        if [ ! -e "$dst" ] && [ -z "$old" ] && [ -f "$dst.rpmsave" ]; then
            run mv -f "$dst.rpmsave" "$dst" && log "$dst: the changed copy was kept"
        fi
        cur=$(xdg_sum "$dst")
        if [ "$cur" = "$new" ]; then
            :   # ya es el de esta versión
        elif [ ! -e "$dst" ] || [ "$cur" = "$old" ]; then
            run install -D -m 0644 "$src" "$dst" || continue
            have restorecon && run restorecon "$dst" 2> /dev/null
        else
            [ -n "$old" ] && log "$dst was changed: left as is"
            xdg_record "$f"
            continue
        fi
        xdg_record "$f" "$new"
    done
}
undo_xdg() {
    local sum f n=0
    while read -r sum f; do
        [ -n "$f" ] && [ "$(xdg_sum "/etc/xdg/$f")" = "$sum" ] || continue
        run rm -f "/etc/xdg/$f" && n=$((n + 1))
    done < <(cat "$STATE/xdg-sums" 2> /dev/null)
    [ "$n" -gt 0 ] && log "KDE defaults of DJOS removed from /etc/xdg"
    return 0
}
undo_plymouth() {
    have plymouth-set-default-theme || return 0
    [ "$(plymouth-set-default-theme 2> /dev/null)" = djos ] || return 0
    local prev
    prev=$(cat "$STATE/plymouth-prev" 2> /dev/null)
    if [ -f "$STATE/backup/plymouthd.conf" ] && [ -f "$PLY_CONF.rpmnew" ]; then
        run mv -f "$PLY_CONF.rpmnew" "$PLY_CONF"   # plymouth se actualizó mientras tanto: su versión nueva
    elif [ -f "$STATE/backup/plymouthd.conf" ]; then
        run cp -a "$STATE/backup/plymouthd.conf" "$PLY_CONF"
    elif [ -n "$prev" ] && [ "$prev" != djos ] && [ -f "/usr/share/plymouth/themes/$prev/$prev.plymouth" ]; then
        run plymouth-set-default-theme "$prev"
    else
        run plymouth-set-default-theme --reset   # la de Fedora (bgrt: el logo del fabricante)
    fi
    log "boot screen back to Fedora's"
}
# al desinstalar, el initramfs se rearma en %postun del paquete: en %preun todavía están los archivos de DJOS que van
# adentro (tema, ntsync, opciones de audio) y quedarían ahí después de sacar el paquete
request_initramfs() {
    have dracut || return 0
    ls /usr/lib/modules/*/vmlinuz > /dev/null 2>&1 || return 0
    [ "$DRY" = 1 ] && { echo "  would rebuild the initramfs once the files are removed"; return 0; }
    : > "$INITRD_REBUILD"
}

# --- Windows en el menú de arranque, si está en otro disco y GRUB todavía no lo tiene (os-prober suele ponerlo al
#     instalar Fedora, pero no si el disco se conectó después o os-prober no lo vio). Va en /boot/grub2/custom.cfg,
#     que el grub.cfg de Fedora lee al arrancar (41_custom). Así DJOS nunca corre grub2-mkconfig: ese corre os-prober,
#     que monta para escritura los discos btrfs que encuentra (p. ej. uno de música), y reescribe las opciones de todas
#     las entradas de arranque. Tampoco se monta nunca la partición de Windows: alcanza con la entrada "Windows Boot
#     Manager" de la placa madre (efibootmgr), y GRUB busca el archivo al arrancar (si el disco no está, no aparece)
CUSTOM_CFG=/boot/grub2/custom.cfg
WIN_BEGIN="### BEGIN DJOS Windows"
WIN_END="### END DJOS Windows"
win_block() {   # con Windows conectado, el menú se muestra 3 segundos (Fedora lo esconde si cree que hay un solo sistema)
    cat << 'EOF'
### BEGIN DJOS Windows (lo agrega DJOS Optimizer y lo saca al desinstalarlo)
if [ "${grub_platform}" = "efi" ]; then
  insmod part_gpt
  insmod fat
  if search --no-floppy --file --set=djos_win /EFI/Microsoft/Boot/bootmgfw.efi; then
    set timeout_style=menu
    if [ "${timeout}" = "0" ]; then set timeout=3; fi
    if [ "${timeout}" = "1" ]; then set timeout=3; fi
    menuentry 'Windows' --class windows --class os --id djos-windows {
      insmod part_gpt
      insmod fat
      insmod chain
      search --no-floppy --file --set=root /EFI/Microsoft/Boot/bootmgfw.efi
      chainloader /EFI/Microsoft/Boot/bootmgfw.efi
    }
  fi
fi
### END DJOS Windows
EOF
}
do_windows() {
    [ -d /sys/firmware/efi ] && [ -f "$GRUB_CFG" ] || return 0
    grep -qF "$WIN_BEGIN" "$CUSTOM_CFG" 2> /dev/null && return 0   # ya está
    # ¿GRUB ya lo tiene? (os-prober, o el de una versión anterior de DJOS): primero esto, sin tocar ningún disco
    grep -qi 'bootmgfw\.efi' "$GRUB_CFG" 2> /dev/null && return 0
    have efibootmgr && efibootmgr 2> /dev/null | grep -qi 'Windows Boot Manager' || return 0
    # con BitLocker, Windows arrancado desde GRUB (pasa por shim) pide la clave de recuperación cada vez
    if lsblk -rno FSTYPE 2> /dev/null | grep -qix bitlocker; then
        log "Windows uses BitLocker: not added to the boot menu (from there it would ask for its recovery key every time). Start it from the PC's boot menu (F12 on Gigabyte boards)."
        return 0
    fi
    grep -q 'custom\.cfg' "$GRUB_CFG" || { log "the GRUB menu doesn't read custom.cfg: Windows not added to it"; return 0; }
    log "Windows found: adding it to the boot menu"
    [ "$DRY" = 1 ] && { echo "  would add a Windows entry to $CUSTOM_CFG"; return 0; }
    # el custom.cfg de otro (si hay) queda igual con lo nuestro al final; si es nuevo, solo lo lee root (como grub.cfg)
    { cat "$CUSTOM_CFG" 2> /dev/null; win_block; } > "$CUSTOM_CFG.djos-new" || { rm -f "$CUSTOM_CFG.djos-new"; return 0; }
    [ -f "$CUSTOM_CFG" ] || chmod 0600 "$CUSTOM_CFG.djos-new"
    replace_file "$CUSTOM_CFG" && mark windows-boot
}
undo_windows() {
    run rm -f "$STATE/windows-boot"
    grep -qF "$WIN_BEGIN" "$CUSTOM_CFG" 2> /dev/null || return 0
    [ "$DRY" = 1 ] && { echo "  would remove the Windows entry from $CUSTOM_CFG"; return 0; }
    awk -v b="$WIN_BEGIN" -v e="$WIN_END" 'index($0, b) == 1 {s = 1} !s {print} index($0, e) == 1 {s = 0}' \
        "$CUSTOM_CFG" > "$CUSTOM_CFG.djos-new" || { rm -f "$CUSTOM_CFG.djos-new"; return 0; }
    if grep -q '[^[:space:]]' "$CUSTOM_CFG.djos-new"; then
        replace_file "$CUSTOM_CFG"
    else   # solo tenía lo nuestro
        rm -f "$CUSTOM_CFG.djos-new" "$CUSTOM_CFG"
    fi
    log "Windows entry removed from the boot menu"
}

# --- limpieza de paquetes
# Grupos (se sacan juntos). Probado en Fedora 44 KDE: nada de esto arrastra lo esencial. NO van (arrastran o rompen
# otras cosas): akonadi-server (se lleva KMail, Kontact… y python3-pyside6, que usa DJOS Center), mariadb* (deja a
# KMail sin base de datos; mariadb-connector-c se lleva LibreOffice), kunifiedpush (se lleva NeoChat),
# plasma-keyboard (se lleva Plasma), kwrite (es el único editor de texto), orca (lector de pantalla).
CLEAN_GROUPS=(
    "kde-connect kdeconnectd krfb"                               # teléfono y escritorio remoto: demonios de red
    "plasma-welcome plasma-welcome-fedora"
    "pipewire-config-raop"                                       # parlantes AirPlay que aparecen solos como salida
    "plasma-vault"
    "hplip hplip-common hplip-libs hplip-gui"                    # drivers viejos de HP (las impresoras
    "gutenprint gutenprint-cups gutenprint-libs"                 # actuales imprimen sin driver)
    "drkonqi plasma-drkonqi"                                     # informes de fallos de KDE
    "abrt abrt-desktop abrt-cli abrt-gui abrt-libs"              # informes de fallos de Fedora (procesa volcados)
    "khelpcenter kdebugsettings kjournald kcharselect kfind kwalletmanager5"
    "gamemode xwaylandvideobridge"
)
# solo si no hay un módem de celular (también se van NetworkManager-wwan y NetworkManager-bluetooth)
CLEAN_MODEM="ModemManager"
# solo en una PC de verdad (en una máquina virtual hacen falta)
CLEAN_GUEST="open-vm-tools open-vm-tools-desktop virtualbox-guest-additions spice-vdagent spice-webdavd qemu-guest-agent hyperv-daemons hyperv-daemons-license hypervkvpd hypervvssd hypervfcopyd"
# lo que nunca se puede ir (si sacar algo lo arrastra, ese algo no se saca)
ESSENTIAL="djos-optimizer plasma-workspace plasma-desktop kwin plasma-systemsettings kscreen kscreenlocker plasma-nm
plasma-pa powerdevil bluedevil xdg-desktop-portal-kde kde-gtk-config plasma-login-manager sddm kde-settings
pipewire pipewire-pulseaudio wireplumber konsole dolphin kwrite plasma-discover plasma-discover-notifier
plasma-discover-offline-updates plasma-discover-packagekit plasma-discover-flatpak flatpak firefox NetworkManager
NetworkManager-wifi dnf5 PackageKit polkit sudo systemd kernel kernel-core kernel-modules linux-firmware
grub2-efi-x64 shim-x64 grubby dracut plymouth tuned tuned-ppd python3-pyside6 kf6-kirigami mesa-dri-drivers
akmods mokutil fedora-release-common"

present() { rpm -q --qf '%{name}\n' "$@" 2> /dev/null | grep -v ' is not installed$'; }
# would_remove <paquete…>: todo lo que dnf sacaría (pedidos, dependientes y dependencias que quedan sin uso).
# Si dnf no puede armar la transacción (p. ej. rompería un paquete protegido como plasma-desktop): "(blocked)"
would_remove() {
    dnf5 -q remove --assumeno "$@" 2>&1 | awk '/^Removing/ {f = 1; next} /^Transaction Summary/ {f = 0; ok = 1}
        f && /^ [^ ]/ {print $1} END { if (!ok) print "(blocked)" }'
}
essential_hits() {   # essential_hits <lista de paquetes>: los esenciales que aparecen ("(blocked)" también cuenta)
    local p ess
    ess=" $(tr '\n' ' ' <<< "$ESSENTIAL") (blocked) "
    for p in $1; do
        case "$ess" in *" $p "*) echo "$p"; continue ;; esac
        # también por familia (lo que arranca la PC, los discos y el driver de video), por si un Fedora nuevo arrastra
        # algo esencial con otro nombre. NetworkManager-wwan y -bluetooth sí se pueden ir (con ModemManager)
        case "$p" in
            akmod-nvidia|kmod-nvidia*|xorg-x11-drv-nvidia*|nvidia-*|\
            kernel|kernel-core|kernel-modules*|grub2-*|shim-*|efibootmgr|dracut*|systemd|systemd-*|glibc*|*-firmware|\
            cryptsetup*|lvm2*|mdadm|btrfs-progs|selinux-policy*) echo "$p" ;;
        esac
    done
}
# (las listas de paquetes se separan en palabras a propósito)
# shellcheck disable=SC2086
do_cleanup() {
    have dnf5 || { echo "dnf5 not found."; return 1; }
    local -a groups=() ok=() skipped=()
    local g p pk list hits
    for g in "${CLEAN_GROUPS[@]}"; do groups+=("$g"); done
    groups+=("$(rpm -qa --qf '%{name}\n' 'ibus*' 'fcitx5*' 2> /dev/null | grep -vx 'ibus-libs' | sort -u | tr '\n' ' ')")
    if have mmcli && mmcli -L 2> /dev/null | grep -q '/Modem/'; then
        log "a mobile broadband modem is present: ModemManager stays"
    else
        groups+=("$CLEAN_MODEM")
    fi
    if [ "$(systemd-detect-virt 2> /dev/null)" = none ]; then groups+=("$CLEAN_GUEST")
    else log "running in a virtual machine: its guest tools stay"; fi

    # solo lo que está instalado
    pk=""
    for g in "${groups[@]}"; do
        p=$(present $g | tr '\n' ' ')
        [ -n "${p// /}" ] && ok+=("$p") && pk="$pk $p"
    done
    [ -n "${pk// /}" ] || { echo "Nothing to remove: this PC is already clean."; return 0; }

    echo "Checking what would be removed..."
    list=$(would_remove $pk | sort -u | tr '\n' ' ')
    hits=$(essential_hits "$list" | tr '\n' ' ')
    if [ -n "${hits// /}" ]; then
        # algún grupo arrastra algo esencial (p. ej. en una versión nueva de Fedora): se prueba uno por uno y se
        # deja afuera el que lo hace
        echo "Removing all of it would take or break essential packages (${hits% }) - checking each group..."
        pk=""
        for g in "${ok[@]}"; do
            if [ -n "$(essential_hits "$(would_remove $g | tr '\n' ' ')")" ]; then skipped+=("$g")
            else pk="$pk $g"; fi
        done
        [ ${#skipped[@]} -gt 0 ] && echo "Kept (removing them would take essential parts of the system): ${skipped[*]}"
        [ -n "${pk// /}" ] || { echo "Nothing can be removed safely."; return 0; }
        list=$(would_remove $pk | sort -u | tr '\n' ' ')
        hits=$(essential_hits "$list" | tr '\n' ' ')
        if [ -n "${hits// /}" ]; then
            echo "ABORTED: the removal would still take or break essential packages: ${hits% }"
            return 1
        fi
    fi
    [ -n "${list// /}" ] || { echo "Nothing to remove."; return 0; }
    echo "Packages that will be removed ($(wc -w <<< "$list")):"
    fold -s -w 100 <<< "$list" | sed 's/^/  /'
    if [ "$DRY" = 1 ]; then echo "(dry run: nothing was removed)"; return 0; fi
    dnf5 -y remove $pk || { echo "The removal failed (nothing essential was touched)."; return 1; }
    echo "Done."
}

# --- NVIDIA: el aviso de la clave (mok-pending) al día
do_nvidia_refresh() { [ -x /usr/libexec/djos/nvidia-setup ] && run /usr/libexec/djos/nvidia-setup --refresh; return 0; }

# --- imágenes que app-update bajó al almacén de podman de root (Richie DJ, ~4 GB). Se borran solo las de DJOS: los
#     repositorios de source.conf y apps.conf, y localhost/<nombre> (pruebas con una imagen local), también sus
#     versiones viejas que quedaron sin nombre (las que alguna vez se llamaron así: NamesHistory); ninguna otra se toca
repo_of() {   # repo_of <imagen>: el repositorio, sin transporte, etiqueta ni digest (nada si es un archivo o carpeta)
    local r=${1#docker://}
    r=${r#containers-storage:}
    case "$r" in ''|oci:*|oci-archive:*|docker-archive:*|dir:*|docker-daemon:*) return 0 ;; esac
    r=${r%%@*}
    case "${r##*/}" in *:*) r=${r%:*} ;; esac
    printf '%s\nlocalhost/%s\n' "$r" "${r##*/}"
}
our_repos() {
    local f id img
    {
        # source.conf del paquete y el de /etc (que lo pisa), en un subshell
        ( DJOS_APP_IMAGE=""; DJOS_OPTIMIZER_IMAGE=""
          for f in "$SHARE/source.conf" /etc/djos/source.conf; do
              # shellcheck source=/dev/null
              [ -r "$f" ] && . "$f"
          done
          printf '%s\n' "$DJOS_APP_IMAGE" "$DJOS_OPTIMIZER_IMAGE" )
        # apps.conf: <id> <imagen> <carpeta> <proceso>
        while read -r id img _; do
            case "$id" in ''|\#*) continue ;; esac
            printf '%s\nlocalhost/%s\n' "$img" "$id"
        done < <(cat /etc/djos/apps.conf 2> /dev/null)
        echo localhost/richiedj
    } | while read -r img; do repo_of "$img"; done | sort -u
}
undo_images() {
    have podman && [ -d /var/lib/containers/storage ] || return 0   # sin almacén no se crea uno
    local repos name id hist r refs=() old=()
    repos=" $(our_repos | tr '\n' ' ') "
    while read -r name; do
        case "$name" in ''|*'<none>'*) continue ;; esac   # sin nombre: van abajo
        case "$repos" in *" ${name%:*} "*) refs+=("$name") ;; esac
    done < <(podman images --format '{{.Repository}}:{{.Tag}}' 2> /dev/null | sort -u)
    while read -r id; do
        [ -n "$id" ] || continue
        hist=" $(podman image inspect --format '{{.NamesHistory}}' "$id" 2> /dev/null | tr -d '[]') "
        for r in $repos; do
            case "$hist" in *" $r:"*|*" $r@"*) old+=("$id"); break ;; esac
        done
    done < <(podman images -q --filter dangling=true 2> /dev/null | sort -u)
    # -f: también el contenedor que app-update deja si lo cortaron a mitad (solo existe con nuestra imagen)
    if [ ${#refs[@]} -gt 0 ] || [ ${#old[@]} -gt 0 ]; then
        if runq podman rmi -f -i "${refs[@]}" "${old[@]}"; then
            log "downloaded images removed: ${refs[*]}${old[*]:+ (and ${#old[@]} older versions)}"
        else
            warn "could not remove the images ${refs[*]} (sudo podman rmi ${refs[*]})"
        fi
    fi
    return 0
}

# --- escritorio: con el paquete se van el tema DJOS, el ícono del menú y el widget de actualizaciones, y la barra de
#     DJOS queda con íconos que faltan. Cada usuario que tenía el escritorio de DJOS recibe un autoarranque de una sola
#     vez, suyo (lo escribe él, 0644; no es del paquete): en su próximo inicio de sesión de Plasma pone el escritorio
#     de Fedora SOLO si el de DJOS sigue puesto (tema org.djos.glass u org.djos.desktop en kdeglobals o, sin tema
#     elegido, la barra de DJOS) y DJOS no se volvió a instalar, y se borra. Si el usuario no vuelve a entrar, queda ahí sin hacer nada.
RESTORE='djos-restore-desktop.desktop'
djos_panel() { grep -qsx -e plugin=org.djos.updates -e icon=djos -e icon=djos-menu -e icon=djos-start "$1/.config/plasma-org.kde.plasma.desktop-appletsrc"; }
restore_entry() {   # restore_entry <carpeta de inicio>: el .desktop, rutas ya escritas (adentro sin $, comillas ni \)
    local c=$1/.config lnf=/usr/share/plasma/look-and-feel self djos apply
    self=$c/autostart/$RESTORE
    djos="grep -qsx -e LookAndFeelPackage=org.djos.glass -e LookAndFeelPackage=org.djos.desktop $c/kdeglobals || { ! grep -qs ^LookAndFeelPackage= $c/kdeglobals && grep -qsx -e plugin=org.djos.updates -e icon=djos -e icon=djos-menu -e icon=djos-start $c/plasma-org.kde.plasma.desktop-appletsrc; }"
    apply="plasma-apply-lookandfeel -a org.fedoraproject.fedora.desktop --resetLayout || plasma-apply-lookandfeel -a org.kde.breeze.desktop --resetLayout"
    cat << EOF
[Desktop Entry]
Type=Application
Name=Restore the Fedora desktop
Comment=Runs once after DJOS Optimizer was removed: gives back Fedora's look and panel
OnlyShowIn=KDE;
Exec=sh -c "if [ -e $lnf/org.djos.desktop ] || ! { $djos; }; then rm -f $self; elif gdbus wait --session --timeout 120 org.kde.plasmashell && sleep 3 && { $apply; }; then rm -f $self; fi"
EOF
}
drop_restore() {   # drop_restore <usuario> <uid> <gid> <carpeta de inicio>
    local u=$1 uid=$2 gid=$3 home=$4
    case "$home" in
        /*) case "$home" in *[!A-Za-z0-9._/-]*) home="" ;; esac ;;
        *) home="" ;;
    esac
    if [ -z "$home" ]; then   # la ruta iría escrita en Exec: con caracteres raros, a mano
        log "$u: to get Fedora's desktop back, run as $u: plasma-apply-lookandfeel -a org.fedoraproject.fedora.desktop --resetLayout"
        return 0
    fi
    [ "$DRY" = 1 ] && { echo "  would add $home/.config/autostart/$RESTORE (Fedora's desktop at the next login)"; return 0; }
    # como el usuario: el archivo es suyo y nada de su carpeta (enlaces) puede hacer escribir a root en otro lado
    # shellcheck disable=SC2016 # los $ son del sh de adentro
    restore_entry "$home" | setpriv --reuid="$uid" --regid="$gid" --init-groups -- sh -c \
        'umask 022 && mkdir -p "$1" && cat > "$1/.$2.tmp" && mv -f "$1/.$2.tmp" "$1/$2"' sh "$home/.config/autostart" "$RESTORE" \
        && log "$u: Fedora's desktop comes back at the next login"
    return 0
}

# lo que DJOS dejó en la carpeta de cada usuario, borrado como el usuario (nada de su carpeta, ni un enlace, puede
# hacer que root borre otra cosa): lo que desktop-setup anotó (aspecto ya aplicado, Richie DJ fijado, avisos: si DJOS
# se vuelve a instalar, arranca de cero), la frecuencia y el buffer de DJOS Center > Audio (sin el ajuste de tiempo
# real de DJOS, un buffer chico hace ruidos en Fedora común) y los autoarranques que DJOS apagó, si siguen tal cual
user_cleanup() {   # user_cleanup <usuario> <uid> <gid> <carpeta>
    if [ "$DRY" = 1 ]; then echo "  would remove DJOS's files in $4 (its state and the DJOS Center audio settings)"; return 0; fi
    # shellcheck disable=SC2016 # los $ son del sh de adentro
    setpriv --reuid="$2" --regid="$3" --init-groups -- sh -c '
        rm -rf "$1/.local/state/djos" "$1/.config/djos" "$1/.cache/djos-preview"
        rm -f "$1/.config/pipewire/pipewire.conf.d/60-djos-user.conf"
        rmdir "$1/.config/pipewire/pipewire.conf.d" "$1/.config/pipewire" 2> /dev/null   # solo si quedaron vacías
        # la vista de detalles de Dolphin que puso desktop-setup (si sigue tal cual)
        d="$1/.local/share/dolphin/view_properties/global/.directory"
        [ "$(cat "$d" 2> /dev/null)" = "$(printf "[Dolphin]\nVersion=4\nViewMode=1\nVisibleRoles=Details_text,Details_size,Details_modificationtime")" ] \
            && rm -f "$d"
        for n in geoclue-demo-agent nvidia-settings-user; do
            f="$1/.config/autostart/$n.desktop"
            [ "$(cat "$f" 2> /dev/null)" = "$(printf "[Desktop Entry]\nType=Application\nName=%s\nHidden=true" "$n")" ] \
                && rm -f "$f"
        done
        exit 0' sh "$4" || warn "$1: could not remove DJOS's files in $4"
}

do_remove_files() {
    run rm -f /etc/udev/rules.d/90-djos-controller-audio.rules
    live && run udevadm control --reload 2> /dev/null
    run rm -rf /etc/djos
    run rm -rf "$STATE" /var/cache/djos
    run rm -f /var/log/djos-bootstrap-upgrade.log /var/log/djos-bootstrap-install.log   # los de bootstrap/install.sh
    # cada usuario: la vuelta al escritorio de Fedora (arriba) y lo que DJOS dejó en su carpeta
    local u uid gid home
    while IFS=: read -r u _ uid gid _ home _; do
        [ "$uid" -ge 1000 ] 2> /dev/null && [ "$uid" -lt 60000 ] && [ -d "$home" ] || continue
        if [ -d "$home/.local/state/djos" ] || djos_panel "$home"; then drop_restore "$u" "$uid" "$gid" "$home"; fi
        user_cleanup "$u" "$uid" "$gid" "$home"
    done < /etc/passwd
    # actualizaciones de Fedora que DJOS dejó bajadas sin instalar: dnf no se puede llamar desde esta desinstalación
    if [ ! -e /system-update ] && grep -Eqx 'status = "?download-complete"?' \
        /usr/lib/sysimage/libdnf5/offline/offline-transaction-state.toml 2> /dev/null; then
        log "Fedora updates that DJOS downloaded (not installed) are still stored: 'sudo dnf5 offline clean' deletes them"
    fi
    log "DJOS settings removed (Richie DJ stays in /opt/richiedj)"
}

# --- principal
cmd=${1:-}; shift || true
for a in "$@"; do
    case "$a" in
        --dry-run) DRY=1 ;;
        *) echo "optimizer-setup: unknown option $a" >&2; exit 2 ;;
    esac
done
if [ "$(id -u)" != 0 ] && [ "$DRY" = 0 ]; then
    echo "optimizer-setup: run it as administrator (sudo)" >&2; exit 1
fi
[ "$DRY" = 1 ] && echo "(dry run: nothing is changed)"
if [ "$DRY" = 0 ] && [ "$cmd" != cleanup ]; then mkdir -p "$STATE" && chmod 0755 "$STATE"; fi

case "$cmd" in
    install)
        do_groups
        do_hostname
        do_kargs install
        do_tuned install
        do_services_first
        do_plymouth install
        do_windows
        do_xdg   # (en %post de la primera instalación ya se puede; al actualizar va en posttrans)
        do_nvidia_refresh
        mark setup-version "$(cat "$SHARE/VERSION" 2> /dev/null)"   # rpm -q da las dos versiones durante la actualización
        ;;
    upgrade)
        do_groups upgrade
        do_kargs upgrade
        do_tuned upgrade
        do_services_upgrade
        do_plymouth upgrade
        do_windows
        do_nvidia_refresh
        mark setup-version "$(cat "$SHARE/VERSION" 2> /dev/null)"   # rpm -q da las dos versiones durante la actualización
        ;;
    posttrans) do_posttrans ;;
    remove)
        # primero se frena el actualizador (se espera a que termine lo que esté haciendo): si no, podría seguir
        # escribiendo en /var/lib/djos o cambiando Richie DJ mientras se deshace todo
        if live && [ "$DRY" = 0 ]; then
            systemctl stop djos-update.timer djos-users.path djos-update.service djos-users.service > /dev/null 2>&1
        fi
        # el perfil de energía (los perfiles djos se van con el paquete) y los argumentos del núcleo
        undo_tuned
        undo_kargs
        undo_windows
        undo_services
        undo_hostname
        undo_plymouth
        request_initramfs
        undo_images   # antes de borrar /etc/djos (source.conf y apps.conf dicen cuáles son)
        undo_xdg      # antes de borrar /var/lib/djos (ahí está qué dejó DJOS en /etc/xdg)
        do_remove_files
        ;;
    cleanup) do_cleanup; exit $? ;;
    groups) do_groups ;;
    *)
        echo "usage: optimizer-setup install|upgrade|posttrans|remove|cleanup|groups [--dry-run]" >&2
        exit 2 ;;
esac
exit 0
