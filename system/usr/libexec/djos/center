def out(args, timeout=8):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def read(path, default=""):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return default


_cache = {}


def cached(key, ttl, fn):
    """Lo que tarda en calcularse (lspci, rpm, nvidia-setup) se guarda unos segundos: la portada refresca seguido."""
    now = time.monotonic()
    hit = _cache.get(key)
    if hit and now - hit[0] < ttl:
        return hit[1]
    val = fn()
    _cache[key] = (now, val)
    return val


def os_release():
    d = {}
    for line in read("/etc/os-release").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            d[k] = v.strip().strip('"')
    return d


def rpm_version(pkg):
    v = out(["rpm", "-q", "--qf", "%{VERSION}", pkg]).strip()
    return "" if (not v or " " in v) else v   # "package … is not installed"


def hardware():
    cpu = ""
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            cpu = line.split(":", 1)[1].strip()
            break
    mem = 0
    m = re.search(r"MemTotal:\s+(\d+)", read("/proc/meminfo"))
    if m:
        mem = round(int(m.group(1)) / 1024 / 1024)
    gpu = ""
    for line in out(["lspci"]).splitlines():
        if re.search(r"VGA|3D controller|Display", line):
            g = line.split(": ", 1)[-1]
            if "NVIDIA" in g or not gpu:
                gpu = re.sub(r"\s*\(rev [0-9a-f]+\)$", "", g)
    plasma = out(["plasmashell", "--version"]).split()
    return {"cpu": cpu, "memory": mem, "gpu": gpu, "plasma": plasma[-1] if plasma else ""}


def nvidia_status():
    """nvidia-setup --status (no hace falta root); si no está, lo que se ve desde /proc."""
    try:
        st = json.loads(out(["/usr/libexec/djos/nvidia-setup", "--status"], timeout=10) or "{}")
    except ValueError:
        st = {}
    if "driver" not in st:
        m = re.search(r"Kernel Module(?: for x86_64)?\s+([\d.]+)", read("/proc/driver/nvidia/version"))
        st["driver"] = m.group(1) if m else ""
    if "mok_pending" not in st:
        st["mok_pending"] = os.path.exists(f"{STATE}/mok-pending")
    return st


def update_status():
    try:
        return json.loads(read(f"{STATE}/update-status.json", "{}") or "{}")
    except ValueError:
        return {}


# quién tiene abierta una placa (el "comm" del proceso), con un nombre que se entienda
OWNER_NAMES = {"pipewire": "PipeWire (desktop audio)", "Richie DJ": "Richie DJ (ALSA Direct)", "richiedj": "Richie DJ (ALSA Direct)"}


def card_live(n):
    """lo que la placa está usando ahora mismo (el hardware, no lo configurado): por cada sentido abierto, frecuencia,
    bits, canales y quién la abrió. Sale de /proc/asound (hw_params y status de cada subdispositivo)"""
    live = {}
    bits_usb = {}
    stream = read(f"/proc/asound/card{n}/stream0")
    for sect, key in (("Playback:", "playback"), ("Capture:", "capture")):
        m = re.search(re.escape(sect) + r"(.*?)(?:\n(?:Playback|Capture):|\Z)", stream, re.S)
        if m:
            b = re.search(r"Bits: (\d+)", m.group(1))
            if b:
                bits_usb[key] = int(b.group(1))
    for sub in sorted(glob.glob(f"/proc/asound/card{n}/pcm*/sub*")):
        kind = "playback" if os.path.basename(os.path.dirname(sub)).endswith("p") else "capture"
        if kind in live:
            continue
        hw = read(f"{sub}/hw_params")
        if not hw or hw.strip() == "closed":
            continue
        rate = re.search(r"^rate: (\d+)", hw, re.M)
        fmt = re.search(r"^format: (\S+)", hw, re.M)
        ch = re.search(r"^channels: (\d+)", hw, re.M)
        pid = re.search(r"owner_pid\s*:\s*(\d+)", read(f"{sub}/status"))
        comm = read(f"/proc/{pid.group(1)}/comm").strip() if pid else ""
        fbits = re.search(r"(\d+)", fmt.group(1)) if fmt else None
        live[kind] = {
            "rate": int(rate.group(1)) if rate else 0,
            "bits": bits_usb.get(kind) or (int(fbits.group(1)) if fbits else 0),
            "channels": int(ch.group(1)) if ch else 0,
            "owner": OWNER_NAMES.get(comm, comm),
        }
    return live


def usb_controller(path):
    """el controlador USB (dirección PCI) del que cuelga un dispositivo de /sys/bus/usb/devices"""
    m = re.findall(r"[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f]", os.path.realpath(path))
    return m[-1] if m else ""


def usb_sharing():
    """webcams en el mismo controlador USB que una placa de audio: [(webcam, placa)]. La cámara le saca ancho de banda
    (cortes con la cámara prendida); otro puerto, de otro controlador, lo evita"""
    cards = {}
    for c in glob.glob("/proc/asound/card[0-9]*"):
        bus = read(f"{c}/usbbus").strip()
        n = c.rsplit("card", 1)[1]
        # la placa de sonido de la misma webcam (su micrófono) no cuenta
        dev = os.path.dirname(os.path.realpath(f"/sys/class/sound/card{n}/device"))
        if any(read(f"{i}/bInterfaceClass").strip() == "0e" for i in glob.glob(f"{dev}/*:*")):
            continue
        if bus:
            ctrl = usb_controller(f"/sys/bus/usb/devices/usb{int(bus.split('/')[0])}")
            m = re.search(rf"^\s*{n} \[.*\]: .* - (.*)$", read("/proc/asound/cards"), re.M)
            cards[ctrl] = m.group(1).strip() if m else "your audio interface"
    out_ = []
    for i in glob.glob("/sys/bus/usb/devices/*:*"):
        if read(f"{i}/bInterfaceClass").strip() != "0e":   # video
            continue
        dev = os.path.dirname(os.path.realpath(i))
        ctrl = usb_controller(dev)
        if ctrl in cards:
            pair = (read(f"{dev}/product").strip() or "a webcam", cards[ctrl])
            if pair not in out_:
                out_.append(pair)
    return out_


def sound_cards():
    cards = []
    for m in re.finditer(r"^\s*(\d+) \[(\S+)\s*\]: ([^\n]*)\n\s*(.*)$", read("/proc/asound/cards"), re.M):
        n, cid, driver, longname = m.group(1), m.group(2), m.group(3), m.group(4).strip()
        usb = os.path.exists(f"/proc/asound/card{n}/usbid")
        hdmi = "HDMI" in longname.upper() or "NVIDIA" in driver.upper() or cid.upper().startswith("NVIDIA")
        name = longname.split(" at ")[0]
        cards.append({"index": int(n), "id": cid, "name": name, "usb": usb, "hdmi": hdmi, "live": card_live(n)})
    # la placa de audio (USB) primero; la salida de video (HDMI) al final
    cards.sort(key=lambda c: (not c["usb"], c["hdmi"], c["index"]))
    return cards


def pw_settings():
    s = {}
    for m in re.finditer(r"key:'([^']+)' value:'([^']*)'", out(["pw-metadata", "-n", "settings"])):
        s[m.group(1)] = m.group(2)
    return s


def card_rates(n):
    """las frecuencias que la placa acepta: las USB las dicen en stream*, las de la placa base en su codec"""
    rates = set()
    for f in glob.glob(f"/proc/asound/card{n}/stream*"):
        for m in re.finditer(r"Rates: ([0-9, ]+)", read(f)):
            rates.update(int(x) for x in re.findall(r"\d+", m.group(1)))
    if not rates:
        for f in glob.glob(f"/proc/asound/card{n}/codec#*"):
            for m in re.finditer(r"^\s*rates \[[^]]*\]: ([0-9 ]+)$", read(f), re.M):
                rates.update(int(x) for x in m.group(1).split())
    return sorted(r for r in rates if r in ALL_RATES) or [44100, 48000, 88200, 96000]


def pw_nodes():
    """las salidas y entradas de las placas en PipeWire y las elegidas por defecto (una sola llamada a pw-dump)"""
    try:
        dump = json.loads(out(["pw-dump"], timeout=10) or "[]")
    except ValueError:
        dump = []
    defaults = {}
    nodes = []
    for o in dump:
        if o.get("type") == "PipeWire:Interface:Metadata" and (o.get("props") or {}).get("metadata.name") == "default":
            for m in o.get("metadata") or []:
                v = m.get("value")
                if isinstance(v, dict) and "name" in v:
                    defaults[m.get("key")] = v["name"]
        if o.get("type") != "PipeWire:Interface:Node":
            continue
        p = (o.get("info") or {}).get("props") or {}
        cls = p.get("media.class")
        if cls not in ("Audio/Sink", "Audio/Source") or "api.alsa.pcm.card" not in p:
            continue
        nodes.append({"id": o.get("id"), "name": p.get("node.name", ""), "kind": "output" if cls == "Audio/Sink" else "input",
                      "description": p.get("node.description", p.get("node.name", "")), "card": int(p.get("api.alsa.pcm.card")),
                      "bus": p.get("device.bus", ""), "headroom": int(p.get("api.alsa.headroom", 0) or 0),
                      "formFactor": p.get("device.form-factor", "")})
    return nodes, defaults


def load_card_settings():
    try:
        d = json.loads(read(CARDS_JSON) or "{}")
    except ValueError:
        d = {}
    return d if isinstance(d, dict) else {}


def write_card_rules(settings):
    """la regla de WirePlumber de lo elegido por placa: frecuencia y buffer fijos mientras esa placa suena
    (node.force-rate / node.force-quantum: sin conversión), el margen de PipeWire (api.alsa.headroom) y la prioridad
    alta de la principal (gana como salida por defecto)"""
    blocks = []
    main = settings.get("main", "")
    names = set(settings.get("cards", {})) | ({main} if main else set())
    for name in sorted(names):
        c = settings.get("cards", {}).get(name, {})
        props = []
        if c.get("rate"):
            props.append(f"node.force-rate = {int(c['rate'])}")
        if c.get("buffer"):
            props.append(f"node.force-quantum = {int(c['buffer'])}")
        if c.get("headroom", -1) >= 0:
            props.append(f"api.alsa.headroom = {int(c['headroom'])}")
        if name == main:
            props += ["priority.session = 3000", "priority.driver = 3000"]
        if not props or not re.fullmatch(r"[A-Za-z0-9_.:-]+", name):
            continue
        blocks.append("  {\n    matches = [ { node.name = \"" + name + "\" } ]\n"
                      "    actions = { update-props = { " + "  ".join(props) + " } }\n  }")
    os.makedirs(os.path.dirname(WP_CARDS_CONF), exist_ok=True)
    if not blocks:
        if os.path.exists(WP_CARDS_CONF):
            os.remove(WP_CARDS_CONF)
        return
    with open(WP_CARDS_CONF + ".tmp", "w", encoding="utf-8") as f:
        f.write("# DJOS Center > Audio > Sound cards: lo que elegiste para cada placa. DJOS Center rehace este archivo\n"
                "# (lo elegido está en ~/.config/djos/sound-cards.json).\nmonitor.alsa.rules = [\n"
                + "\n".join(blocks) + "\n]\n")
    os.replace(WP_CARDS_CONF + ".tmp", WP_CARDS_CONF)


def set_playing():
    return subprocess.run(["/usr/libexec/djos/gig-guard"]).returncode == 1


class Backend(QObject):
    jobDone = Signal(str, int, str)   # etiqueta, código de salida, salida

    def __init__(self):
        super().__init__()
        self._procs = set()

    # --- procesos -------------------------------------------------------------------------------------------------
    @Slot(str, "QVariantList")
    def run(self, tag, args):
        """Corre algo en segundo plano; al terminar emite jobDone(tag, código, salida)."""
        p = QProcess(self)
        p.setProcessChannelMode(QProcess.MergedChannels)
        self._procs.add(p)

        def done(code, _status, p=p, tag=tag):
            text = bytes(p.readAll()).decode("utf-8", "replace")
            self._procs.discard(p)
            p.deleteLater()
            self.jobDone.emit(tag, code, text)

        p.finished.connect(done)
        p.start(str(args[0]), [str(a) for a in args[1:]])

    @Slot("QVariantList")
    def launch(self, args):
        QProcess.startDetached(str(args[0]), [str(a) for a in args[1:]])

    @Slot(str)
    def terminal(self, command):
        QProcess.startDetached("konsole", ["--hide-menubar", "-e", "bash", "-lc", command])

    # --- audio ----------------------------------------------------------------------------------------------------
    @Slot(result=str)
    def audio(self):
        s = pw_settings()
        rate = int(s.get("clock.rate", "48000") or 48000)
        quantum = int(s.get("clock.quantum", "256") or 256)
        force_q = int(s.get("clock.force-quantum", "0") or 0)
        cmdline = read("/proc/cmdline")
        rt_threads = []
        for line in out(["ps", "-eLo", "rtprio=,comm="]).splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2 and parts[0].isdigit() and int(parts[0]) >= 85 and parts[1].startswith("irq/"):
                rt_threads.append(f"{parts[1]} (FIFO {parts[0]})")
        try:
            import resource
            rtprio = resource.getrlimit(resource.RLIMIT_RTPRIO)[0]
            memlock = resource.getrlimit(resource.RLIMIT_MEMLOCK)[0]
        except Exception:
            rtprio, memlock = 0, 0
        allowed = re.findall(r"\d+", s.get("clock.allowed-rates", ""))
        return json.dumps({
            "rate": rate, "quantum": force_q or quantum,
            "followRate": len(allowed) > 1,
            "configuredRate": self._conf_value("default.clock.rate", 48000),
            "configuredQuantum": self._conf_value("default.clock.quantum", 256),
            "cards": sound_cards(),
            "rtLimits": rtprio >= 90 and (memlock == -1 or memlock > 1 << 30),
            "kernelRt": "threadirqs" in cmdline and "preempt=full" in cmdline,
            "irqThreads": rt_threads,
            "usbShared": [f"{w} and {c}" for w, c in usb_sharing()],
            "tuned": out(["tuned-adm", "active"]).split(":")[-1].strip(),
        })

    def _conf_value(self, key, default):
        m = re.search(re.escape(key) + r"\s*=\s*(\d+)", read(PW_USER_CONF))
        return int(m.group(1)) if m else default

    @Slot(result=str)
    def soundCards(self):
        """Audio > Sound cards: cada salida con lo que acepta, lo que usa ahora, lo elegido, y la principal; las
        entradas para elegir la principal; y los valores del sistema (lo que usa una placa sin ajustes propios)"""
        s = pw_settings()
        nodes, defaults = pw_nodes()
        saved = load_card_settings()
        live = {c["index"]: c for c in sound_cards()}
        outs, ins = [], []
        for n in nodes:
            card = live.get(n["card"], {})
            item = {"name": n["name"], "description": n["description"], "card": n["card"], "usb": n["bus"] == "usb",
                    "hdmi": card.get("hdmi", False), "rates": card_rates(n["card"]), "headroom": n["headroom"],
                    "settings": saved.get("cards", {}).get(n["name"], {}),
                    "live": card.get("live", {}), "isDefault": defaults.get(
                        "default.audio.sink" if n["kind"] == "output" else "default.audio.source") == n["name"]}
            (outs if n["kind"] == "output" else ins).append(item)
        outs.sort(key=lambda c: (not c["usb"], c["hdmi"], c["card"]))
        ins.sort(key=lambda c: (not c["usb"], c["card"]))
        return json.dumps({
            "systemRate": int(s.get("clock.rate", "48000") or 48000),
            "systemBuffer": int(s.get("clock.quantum", "256") or 256),
            "outputs": outs, "inputs": ins, "main": saved.get("main", ""), "set": set_playing(),
            "rates": list(ALL_RATES), "buffers": list(BUFFERS), "headrooms": list(HEADROOMS),
        })

    @Slot(str, result=str)
    def setSoundCards(self, payload):
        """Guarda lo elegido por placa y lo aplica: reinicia WirePlumber (el audio se corta un instante) y elige la
        principal como salida por defecto. Nunca con un set sonando. Devuelve "" si salió bien, o el motivo."""
        if set_playing():
            return "A set is playing: change sound cards when it ends."
        try:
            d = json.loads(payload)
        except ValueError:
            return "Invalid settings."
        settings = {"main": str(d.get("main", "")), "cards": {}}
        for name, c in (d.get("cards") or {}).items():
            entry = {}
            if int(c.get("rate", 0) or 0) in ALL_RATES:
                entry["rate"] = int(c["rate"])
            if int(c.get("buffer", 0) or 0) in BUFFERS:
                entry["buffer"] = int(c["buffer"])
            if int(c.get("headroom", -1)) in HEADROOMS:
                entry["headroom"] = int(c["headroom"])
            if entry:
                settings["cards"][str(name)] = entry
        os.makedirs(os.path.dirname(CARDS_JSON), exist_ok=True)
        with open(CARDS_JSON, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=1)
        write_card_rules(settings)
        out(["systemctl", "--user", "restart", "wireplumber.service"], timeout=20)
        # la principal, como salida por defecto (WirePlumber la recuerda); los nodos tardan un poco en volver
        main_in = str(d.get("mainInput", ""))
        for _ in range(20):
            time.sleep(0.25)
            nodes, _defaults = pw_nodes()
            ids = {n["name"]: n["id"] for n in nodes}
            if not settings["main"] or settings["main"] in ids:
                break
        if settings["main"] in ids:
            out(["wpctl", "set-default", str(ids[settings["main"]])])
        if main_in in ids:
            out(["wpctl", "set-default", str(ids[main_in])])
        try:
            os.remove(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "djos-audio-nodes"))   # caché de audio-now
        except OSError:
            pass
        return ""

    @Slot(result=str)
    def cards(self):
        """Solo las placas y lo que usan ahora (barato: para refrescar cada pocos segundos)."""
        return json.dumps(sound_cards())

    @Slot(int, int, bool, result=bool)
    def setAudio(self, rate, quantum, follow=False):
        """Frecuencia y tamaño de buffer de PipeWire: se guarda para el usuario y se aplica al instante. Frecuencia fija
        (lo normal: sin "pops" de la placa al cambiar) o, con follow, la de lo que suena (sin conversión, bit-perfect)."""
        rates = (44100, 48000, 88200, 96000)
        rate = rate if rate in rates else 48000
        quantum = quantum if quantum in (32, 64, 128, 256, 512, 1024, 2048) else 256
        allowed = list(rates) if follow else [rate]
        allowed_txt = "[ " + " ".join(str(r) for r in allowed) + " ]"
        os.makedirs(os.path.dirname(PW_USER_CONF), exist_ok=True)
        with open(PW_USER_CONF, "w", encoding="utf-8") as f:
            f.write("# DJOS Center: frecuencia y buffer elegidos por el usuario\n"
                    "context.properties = {\n"
                    f"    default.clock.rate          = {rate}\n"
                    f"    default.clock.allowed-rates = {allowed_txt}\n"
                    f"    default.clock.quantum       = {quantum}\n"
                    f"    default.clock.min-quantum   = {min(32, quantum)}\n"
                    "}\n")
        for k, v in (("clock.rate", rate), ("clock.allowed-rates", allowed_txt), ("clock.quantum", quantum),
                     ("clock.min-quantum", min(32, quantum)), ("clock.force-rate", 0), ("clock.force-quantum", 0)):
            out(["pw-metadata", "-n", "settings", "0", k, str(v)])
        return True

    @Slot(result=str)
    def controllers(self):
        """Controladoras Pioneer conectadas cuya placa de sonido Linux no maneja (ver controller-audio)."""
        return out(["/usr/libexec/djos/controller-audio", "status"], timeout=15).strip() or "[]"

    # --- rendimiento ----------------------------------------------------------------------------------------------
    # Fedora 44 trae tuned-ppd (sin powerprofilesctl): el modo se lee y se cambia por D-Bus, la misma interfaz que
    # usa Plasma (también la de power-profiles-daemon). tuned-ppd lo pasa a los perfiles djos (/etc/tuned/ppd.conf)
    @Slot(result=str)
    def powerProfile(self):
        m = re.match(r's "([^"]+)"', out(["busctl", "get-property", *PPD_PROFILE]).strip())
        return m.group(1) if m else "performance"

    @Slot(str)
    def setPowerProfile(self, profile):
        if profile in ("performance", "balanced", "power-saver"):
            out(["busctl", "set-property", *PPD_PROFILE, "s", profile])

    @Slot(result=bool)
    def playing(self):
        """Un set sonando: alguien que no es tuned pidió latencia mínima del procesador (Richie DJ al reproducir)."""
        return subprocess.run(["/usr/libexec/djos/gig-guard"], capture_output=True).returncode != 0

    # --- sistema --------------------------------------------------------------------------------------------------
    @Slot(result=str)
    def system(self):
        rel = os_release()
        hw = cached("hw", 3600, hardware)
        nv = cached("nvidia", 60, nvidia_status)
        optimizer = cached("optimizer", 60, lambda: rpm_version("djos-optimizer"))
        release = update_status().get("release") or {}
        return json.dumps({
            "name": rel.get("PRETTY_NAME", "Fedora Linux"),   # p. ej. Fedora Linux 44 (KDE Plasma Desktop Edition)
            "fedora": rel.get("VERSION_ID", ""),
            "version": optimizer,                              # versión de DJOS = la del paquete djos-optimizer
            "plasma": hw["plasma"],
            "kernel": os.uname().release,
            "cpu": hw["cpu"], "memory": hw["memory"], "gpu": hw["gpu"],
            "nvidia": nv.get("driver", ""),
            "nvidiaCard": "NVIDIA" in hw["gpu"] or nv.get("gpu") is True,
            "mokPending": nv.get("mok_pending") is True,
            "secureBoot": nv.get("secure_boot") is True,
            "newVersion": release.get("available", "") if release.get("ready") else "",
            "richiedj": os.path.exists("/usr/local/share/applications/richiedj.desktop"),
            "richiedjVersion": read("/opt/richiedj/.djos-version").strip(),
        })

    @Slot(result=str)
    def disks(self):
        try:
            data = json.loads(out(["lsblk", "-J", "-b", "-o", "NAME,PATH,TYPE,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINTS,MODEL,TRAN,PARTTYPE"]))
        except ValueError:
            return "[]"
        # particiones de arranque y de sistema (la EFI, la reservada y la de recuperación de Windows) no son música
        skip_types = {"c12a7328-f81f-11d2-ba4b-00a0c93ec93b", "e3c9e316-0b5c-4db8-817d-f92df00215ae",
                      "de94bba4-06d1-4d40-a16a-bfd50179d6ac", "0xef", "0x27"}
        music = {}   # discos ya preparados con "Set Up Music Disk": UUID -> carpeta
        for line in read("/etc/fstab").splitlines():
            if "# djos-music" in line and line.startswith("UUID="):
                parts = line.split()
                music[parts[0][5:]] = parts[1]
        res = []

        def walk(devs, model="", tran=""):
            for d in devs:
                mdl = d.get("model") or model
                tr = d.get("tran") or tran
                if d.get("type") == "part" and d.get("fstype") in ("ntfs", "exfat", "vfat", "ext4", "xfs", "btrfs"):
                    mps = [m for m in (d.get("mountpoints") or []) if m]
                    # el disco de Fedora: "/" y "/home" (subvolúmenes btrfs de la misma partición), /boot y la EFI
                    system = any(m in ("/", "/home", "/boot", "/boot/efi", "/efi", "/var", "/usr") for m in mps)
                    system = system or (d.get("parttype") or "").lower() in skip_types
                    if not system and (d.get("label") or "").lower() not in ("boot", "efi", "recovery"):
                        res.append({"path": d.get("path"), "label": d.get("label") or "", "fs": d.get("fstype"),
                                    "size": int(d.get("size") or 0), "mounted": mps[0] if mps else "",
                                    "music": music.get(d.get("uuid") or "", ""),
                                    "model": (mdl or "").strip(), "usb": tr == "usb"})
                walk(d.get("children") or [], mdl, tr)

        walk(data.get("blockdevices", []))
        return json.dumps(res)

    # --- programas ------------------------------------------------------------------------------------------------
    @Slot(result=str)
    def catalog(self):
        return json.dumps(catalog())

    @Slot(result=str)
    def guide(self):
        """"¿Qué app uso?": cada tarea con sus apps del catálogo (instalada o a un clic)"""
        try:
            tasks = json.loads(read(f"{SHARE}/guide.json", "[]"))
        except ValueError:
            tasks = []
        byname = {a["name"]: a for a in catalog()}
        for t in tasks:
            t["apps"] = [byname[n] for n in t.get("apps", []) if n in byname]
        return json.dumps(tasks)


APP_DIRS = ("/usr/share/applications", "/usr/local/share/applications")


def catalog():
    try:
        cat = json.loads(read(f"{SHARE}/apps.json", "[]"))
    except ValueError:
        cat = []
    flat = set(out(["flatpak", "list", "--columns=application"], timeout=20).split())
    for a in cat:
        if a.get("native"):
            # paquetes de Fedora: los trae el optimizador (recomendados); si alguno falta, se instala con PackageKit
            # (pkcon, "rpm") y no se ofrece sacarlo. "managed": los trae DJOS (Richie DJ, DJOS Preview)
            path = next((os.path.join(d, a["native"]) for d in APP_DIRS
                         if os.path.exists(os.path.join(d, a["native"]))), "")
            a["installed"] = bool(path)
            a["included"] = a["installed"]
            a["path"] = path
            m = re.search(r"^Icon=(\S+)", read(path), re.M) if path else None
            if m and a.get("managed"):
                a["icon"] = m.group(1)   # el ícono que trae el programa (Richie DJ lo instala con su lanzador)
        else:
            ids = a.get("flatpaks") or [a["flatpak"]]
            a["installed"] = all(i in flat or any(f.startswith(i + "/") or f == i for f in flat) for i in ids)
    return cat


def main():
    page = "overview"
    if "--page" in sys.argv:
        i = sys.argv.index("--page")
        if i + 1 < len(sys.argv):
            page = sys.argv[i + 1]
    app = QApplication(sys.argv)
    app.setApplicationName("DJOS Center")
    app.setOrganizationName("DJOS")
    app.setDesktopFileName("org.djos.center")
    if not QIcon.themeName() or QIcon.themeName() == "hicolor":
        m = re.search(r"^\[Icons\]\s*\nTheme=(\S+)", read(os.path.expanduser("~/.config/kdeglobals")) or read("/etc/xdg/kdeglobals"), re.M)
        QIcon.setThemeName(m.group(1) if m else "Papirus-Dark")
    app.setWindowIcon(QIcon.fromTheme("djoscenter"))
    engine = QQmlApplicationEngine()
    backend = Backend()
    engine.rootContext().setContextProperty("djos", backend)
    engine.rootContext().setContextProperty("startPage", page)
    engine.load(QUrl.fromLocalFile(f"{SHARE}/Main.qml"))
    if not engine.rootObjects():
        sys.exit(1)
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
