# DJOS: ventanas sin bordes gruesos, sin "sacudir el mouse para agrandarlo" y sin teclado en pantalla
# (Fedora lo trae prendido en /usr/share/kde-settings/kde-profile/default/xdg/kwinrc; esto manda sobre eso)
[org.kde.kdecoration2]
BorderSize=None
BorderSizeAuto=false
ButtonsOnLeft=
ButtonsOnRight=IAX
library=org.kde.breeze
theme=Breeze

[Windows]
BorderlessMaximizedWindows=false

[Plugins]
shakecursorEnabled=false

[Wayland]
InputMethod=
VirtualKeyboardEnabled=false
