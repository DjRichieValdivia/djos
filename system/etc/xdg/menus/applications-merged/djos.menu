<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">
<!--
  DJOS: fuera del menú de aplicaciones lo que en Wayland o en una PC de DJ no sirve (siguen instalados y se pueden
  abrir desde la búsqueda o una terminal): configuración de NVIDIA (en Wayland no aplica), el visor de teclados,
  el editor del menú, el cortafuegos, htop y las variantes técnicas de Carla (queda Carla).
  Plasma suma este archivo a su menú (DefaultMergeDirs de plasma-applications.menu). Cada <Exclude> vale solo
  para su submenú, por eso se repite en todos (también en "Applications", el de "sin categoría": si no, lo que se
  saca de un submenú aparecería ahí).
-->
<Menu>
	<Name>Applications</Name>
	<Menu>
		<Name>Applications</Name>
		<Exclude>
			<Filename>nvidia-settings.desktop</Filename>
			<Filename>kbd-layout-viewer5.desktop</Filename>
			<Filename>org.kde.kmenuedit.desktop</Filename>
			<Filename>firewall-config.desktop</Filename>
			<Filename>htop.desktop</Filename>
			<Filename>carla-control.desktop</Filename>
			<Filename>carla-jack-multi.desktop</Filename>
			<Filename>carla-jack-single.desktop</Filename>
			<Filename>carla-patchbay.desktop</Filename>
			<Filename>carla-rack.desktop</Filename>
		</Exclude>
	</Menu>
