			<Filename>puddletag.desktop</Filename>
			<Filename>org.kde.kid3.desktop</Filename>
			<Filename>org.kde.kid3-qt.desktop</Filename>
			<Filename>org.musicbrainz.Picard.desktop</Filename>
			<Filename>soundconverter.desktop</Filename>
			<Filename>sonic-visualiser.desktop</Filename>
			<Filename>cc.spek.Spek.desktop</Filename>
		</Include>
	</Menu>
	<Menu>
